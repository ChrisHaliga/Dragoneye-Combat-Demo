<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root" class="root">
        <Style src="SessionMenu.uss" />
        <Style src="Help.uss" />
        <Style src="Chrome.uss" />

        <!-- Every screen fills the window and is stacked on the same spot. Two archetypes: a stage,
             which uses the whole frame, and a dialog, which centres a plate in it. Nothing is a
             420px card floating in the middle of an empty screen any more. -->

        <ui:VisualElement name="start-panel" class="screen screen--centre">
            <ui:VisualElement class="start">
                <ui:Label text="DRAGONEYE" class="start__title" />
                <ui:VisualElement class="rule rule--long" />
                <ui:Label text="C O M B A T   D E M O" class="start__sub" />
                <ui:Label name="start-prompt" text="PRESS ANY KEY" class="start__prompt" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- HOME -->

        <ui:VisualElement name="home-panel" class="screen stage is-hidden">
            <ui:VisualElement class="home">
                <ui:VisualElement class="home__left">
                    <ui:Label text="DRAGONEYE" class="home__mark" />
                    <ui:VisualElement class="rule" />
                    <ui:Label text="C O M B A T   D E M O" class="home__sub" />

                    <ui:VisualElement class="menu-stack">
                        <ui:Button name="singleplayer-button" text="Singleplayer" class="btn btn--menu btn--primary" />
                        <ui:Button name="multiplayer-button" text="Multiplayer" class="btn btn--menu" />
                        <ui:Button name="test-mode-button" text="Test Mode" class="btn btn--menu" />
                        <ui:Button name="help-button" text="Help" class="btn btn--menu" />
                        <ui:Button name="settings-button" text="Settings" class="btn btn--menu" />
                        <ui:Button name="quit-button" text="Quit" class="btn btn--menu btn--ghost" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="home__right">
                    <ui:VisualElement name="home-hero" class="hero">
                        <ui:Label text="PLAYING AS" class="eyebrow" />
                        <ui:Label name="playing-as-label" text="" class="hero__name" />
                        <ui:VisualElement name="home-hero-body" class="hero__body" />
                        <ui:Button name="levelup-open-button" text="Level up" class="btn btn--primary btn--compact" />
                        <ui:Button name="change-character-button" text="Change character" class="btn btn--ghost btn--compact" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- CHARACTERS -->

        <ui:VisualElement name="characters-panel" class="screen stage is-hidden">
            <ui:VisualElement class="stage__head">
                <ui:Label text="YOUR CHARACTERS" class="stage__title" />
                <ui:Label name="characters-note" text="" class="stage__note" />
            </ui:VisualElement>
            <ui:VisualElement class="rule rule--head" />

            <ui:VisualElement class="stage__body">
                <ui:VisualElement class="rail">
                    <ui:ScrollView name="character-list" class="rail__list" />
                    <ui:Button name="character-new-button" text="New character" class="btn rail__new" />
                </ui:VisualElement>

                <ui:VisualElement name="character-sheet" class="sheet" />
            </ui:VisualElement>

            <ui:VisualElement class="stage__foot">
                <ui:Button name="character-delete-button" text="Delete" class="btn btn--ghost" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="character-edit-button" text="Edit" class="btn" />
                <ui:Button name="character-play-button" text="Play" class="btn btn--primary btn--wide" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- CREATOR -->

        <!-- Four pages, one decision each: who, class, body and kit, and the sheet read back. -->
        <ui:VisualElement name="create-panel" class="screen stage is-hidden">
            <ui:VisualElement class="stage__head">
                <ui:Label name="create-title" text="NEW CHARACTER" class="stage__title" />
                <ui:Label name="create-steps" text="" class="stage__steps" />
                <ui:Label name="create-faults" text="" class="stage__fault" />
            </ui:VisualElement>
            <ui:VisualElement class="rule rule--head" />

            <!-- Page one: a name, a face, a species. -->
            <ui:VisualElement name="create-page-1" class="stage__body page">
                <ui:VisualElement class="col col--identity">
                    <ui:VisualElement name="create-identity" class="group" />
                    <ui:Label text="FACE" class="col__title col__title--spaced" />
                    <ui:VisualElement name="create-portrait" class="portrait portrait--large">
                        <ui:Label name="create-portrait-initial" text="?" class="portrait__initial" />
                    </ui:VisualElement>
                    <ui:VisualElement name="create-portrait-controls" class="group" />
                </ui:VisualElement>
                <ui:VisualElement class="col col--wide">
                    <ui:Label text="SPECIES" class="col__title" />
                    <ui:Label text="What the character is. Each gives a few points before anything is bought, and every one can catch its breath." class="page__lead" />
                    <ui:VisualElement name="create-species" class="choice-grid" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Page two: the class, with every skill it will ever grant. -->
            <ui:VisualElement name="create-page-2" class="stage__body page is-hidden">
                <ui:VisualElement class="col col--classes">
                    <ui:Label text="CLASS" class="col__title" />
                    <ui:ScrollView name="create-class-list" mode="Vertical" class="class-list" />
                </ui:VisualElement>
                <ui:VisualElement class="col col--sheet">
                    <ui:ScrollView name="create-class-detail" mode="Vertical" class="sheet-scroll" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Page three: the points, the pool and the kit. -->
            <ui:VisualElement name="create-page-3" class="stage__body page is-hidden">
                <ui:VisualElement class="col col--attributes-tall">
                    <ui:Label text="ATTRIBUTES" class="col__title" />
                    <ui:Label name="create-budget" text="" class="budget" />
                    <ui:VisualElement name="create-attributes" class="group" />
                </ui:VisualElement>
                <ui:VisualElement class="col col--kit">
                    <ui:Label name="create-elements-title" text="STARTING ELEMENTS" class="col__title" />
                    <ui:Label text="What the character brings to every fight. Spent to attack and to answer attacks, and comes back a breath at a time." class="page__lead" />
                    <ui:VisualElement name="create-elements" class="group" />
                </ui:VisualElement>
                <ui:VisualElement class="col col--kit">
                    <ui:Label text="EQUIPMENT" class="col__title" />
                    <ui:Label text="A weapon is its skills. Armour stops blows and slows you. A shield makes you answer with the better of two." class="page__lead" />
                    <ui:VisualElement name="create-equipment" class="group" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Page four: the sheet, as the roster will show it. -->
            <ui:VisualElement name="create-page-4" class="stage__body page is-hidden">
                <ui:VisualElement class="col col--sheet">
                    <ui:ScrollView name="create-sheet-scroll" mode="Vertical" class="sheet-scroll">
                        <ui:VisualElement class="sheet__head">
                            <ui:VisualElement name="create-overview-portrait" class="portrait portrait--overview" />
                            <ui:VisualElement class="sheet__titles">
                                <ui:Label name="create-summary-name" text="Unnamed" class="sheet__name" />
                                <ui:Label name="create-summary-class" text="" class="sheet__class" />
                                <ui:VisualElement name="create-stats" class="statline" />
                                <ui:VisualElement name="create-xp" class="xp" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="ATTRIBUTES" class="col__title col__title--spaced" />
                        <ui:VisualElement name="create-attrs" class="attr-grid" />
                        <ui:VisualElement class="sheet__columns sheet__columns--flat">
                            <ui:VisualElement class="sheet__column">
                                <ui:Label text="POOL" class="col__title" />
                                <ui:VisualElement name="create-pool" class="gem-row" />
                                <ui:Label text="EQUIPMENT" class="col__title col__title--spaced" />
                                <ui:VisualElement name="create-kit" class="group" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sheet__column">
                                <ui:Label text="SKILLS" class="col__title" />
                                <ui:VisualElement name="create-skills" class="group" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="stage__foot">
                <ui:Button name="create-cancel-button" text="Cancel" class="btn btn--ghost" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="create-back-button" text="Back" class="btn" />
                <ui:Button name="create-next-button" text="Next" class="btn btn--primary btn--wide" />
                <ui:Button name="create-save-button" text="Save character" class="btn btn--primary btn--wide" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- LEVEL UP -->

        <ui:VisualElement name="levelup-panel" class="screen stage is-hidden">
            <ui:VisualElement class="stage__head">
                <ui:Label text="LEVEL UP" class="stage__title" />
                <ui:Label name="levelup-fault" text="" class="stage__fault" />
            </ui:VisualElement>
            <ui:VisualElement class="rule rule--head" />

            <ui:VisualElement class="stage__body">
                <ui:VisualElement class="col col--identity">
                    <ui:Label name="levelup-name" text="" class="sheet__name" />
                    <ui:Label name="levelup-arc" text="" class="levelup__arc" />
                    <ui:Label name="levelup-xp" text="" class="sheet__class" />
                    <ui:Label text="UNLOCKED" class="col__title col__title--spaced" />
                    <ui:VisualElement name="levelup-unlocked" class="group" />
                </ui:VisualElement>

                <ui:VisualElement class="col col--kit">
                    <ui:Label name="levelup-elements-title" text="SPEND YOUR POINTS" class="col__title" />
                    <ui:VisualElement name="levelup-elements" class="group" />
                </ui:VisualElement>

                <ui:VisualElement class="col col--sheet">
                    <ui:ScrollView name="levelup-sheet-scroll" mode="Vertical" class="sheet-scroll">
                        <ui:Label name="levelup-summary-name" text="" class="sheet__name" />
                        <ui:Label name="levelup-summary-class" text="" class="sheet__class" />
                        <ui:VisualElement name="levelup-stats" class="statline" />
                        <ui:VisualElement name="levelup-xp-bar" class="xp" />
                        <ui:VisualElement name="levelup-attrs" class="attr-grid" />
                        <ui:Label text="POOL" class="col__title col__title--spaced" />
                        <ui:VisualElement name="levelup-pool" class="gem-row" />
                        <ui:Label text="SKILLS" class="col__title col__title--spaced" />
                        <ui:VisualElement name="levelup-skills" class="group" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="stage__foot">
                <ui:Button name="levelup-later-button" text="Later" class="btn btn--ghost" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="levelup-confirm-button" text="Confirm" class="btn btn--primary btn--wide" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- TEST MODE. Scenarios that play themselves; TestModeScreen fills the list. -->

        <ui:VisualElement name="test-panel" class="screen stage is-hidden">
            <ui:VisualElement class="stage__head">
                <ui:Label text="TEST MODE" class="stage__title" />
                <ui:Label name="test-note" text="" class="stage__note" />
            </ui:VisualElement>
            <ui:VisualElement class="rule rule--head" />

            <ui:ScrollView name="test-list" class="stage__body test-list" />

            <ui:VisualElement class="stage__foot">
                <ui:Button name="test-back-button" text="Back" class="btn btn--ghost" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="test-copy-button" text="Copy report" class="btn" />
                <ui:Button name="test-run-all-button" text="Run all" class="btn btn--primary btn--wide" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- SETTINGS -->

        <ui:VisualElement name="settings-panel" class="screen stage is-hidden">
            <ui:VisualElement class="stage__head">
                <ui:Label text="SETTINGS" class="stage__title" />
            </ui:VisualElement>
            <ui:VisualElement class="rule rule--head" />

            <!-- Built by SettingsPanel, because the pause menu shows the same controls in
                 another scene and two copies of a settings screen is one too many. -->
            <ui:VisualElement name="settings-body" class="stage__body stage__body--centred" />

            <ui:VisualElement class="stage__foot">
                <ui:Button name="settings-reset-button" text="Reset to defaults" class="btn btn--ghost" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="settings-back-button" text="Back" class="btn btn--primary btn--wide" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- HELP. The rules. Built by HelpBook, which the pause menu also builds into. -->

        <ui:VisualElement name="help-panel" class="screen stage is-hidden">
            <ui:VisualElement class="stage__head">
                <ui:Label text="HOW TO PLAY" class="stage__title" />
            </ui:VisualElement>
            <ui:VisualElement class="rule rule--head" />

            <ui:ScrollView name="help-body" class="stage__body help" />

            <ui:VisualElement class="stage__foot">
                <ui:VisualElement class="spacer" />
                <ui:Button name="help-back-button" text="Back" class="btn btn--primary btn--wide" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- DIALOGS. No lobby among them: once a session exists the prepare-for-battle
             board covers this document, so the join code, readiness and Start live there. -->

        <ui:VisualElement name="multiplayer-panel" class="screen screen--centre is-hidden">
            <ui:VisualElement class="dialog">
                <ui:Label text="MULTIPLAYER" class="dialog__title" />
                <ui:VisualElement class="rule" />
                <ui:Label text="Play over the internet with a join code." class="dialog__note" />

                <ui:Button name="host-menu-button" text="Host a game" class="btn btn--primary btn--block" />
                <ui:Button name="join-menu-button" text="Join a game" class="btn btn--block" />
                <ui:Button name="multiplayer-back-button" text="Back" class="btn btn--ghost btn--block" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="host-panel" class="screen screen--centre is-hidden">
            <ui:VisualElement class="dialog">
                <ui:Label text="HOST A GAME" class="dialog__title" />
                <ui:VisualElement class="rule" />
                <ui:Label text="You will get a join code to share once the lobby opens." class="dialog__note" />

                <ui:VisualElement class="field-group">
                    <ui:Label text="Your name" class="field-label" />
                    <ui:TextField name="host-name-field" max-length="20" class="text-input" />
                </ui:VisualElement>

                <ui:Button name="host-button" text="Open lobby" class="btn btn--primary btn--block" />
                <ui:Button name="host-back-button" text="Back" class="btn btn--ghost btn--block" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="join-panel" class="screen screen--centre is-hidden">
            <ui:VisualElement class="dialog">
                <ui:Label text="JOIN A GAME" class="dialog__title" />
                <ui:VisualElement class="rule" />
                <ui:Label text="Ask the host for their six-character join code." class="dialog__note" />

                <ui:VisualElement class="field-group">
                    <ui:Label text="Your name" class="field-label" />
                    <ui:TextField name="join-name-field" max-length="20" class="text-input" />
                </ui:VisualElement>

                <ui:VisualElement class="field-group">
                    <ui:Label text="Join code" class="field-label" />
                    <ui:TextField name="code-field" max-length="6" class="text-input text-input--code" />
                </ui:VisualElement>

                <ui:Button name="join-button" text="Join game" class="btn btn--primary btn--block" />
                <ui:Button name="join-back-button" text="Back" class="btn btn--ghost btn--block" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="status-label" text="" class="status" />
    </ui:VisualElement>
</ui:UXML>
