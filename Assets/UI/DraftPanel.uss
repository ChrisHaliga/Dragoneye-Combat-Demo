/* The draft board.

   Sits alongside the session menu rather than inside it, so the multiplayer assembly's UI does not
   need to know creatures exist. It borrows the menu's generated frames so the two screens are
   plainly the same game -- the images live in Assets/UI/Generated and are baked by UiArtSetup.

   The layout is the state: one column per party, one card per combatant, and a card is a card
   whether it came out of the draft pool or a player brought it. What differs between them is what
   the card offers, not which list it lives in. */

.draft-root {
    flex-grow: 1;
}

.draft {
    flex-grow: 1;
    padding: 34px 48px 26px 48px;
    background-image: url("Generated/ui-backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
}

.draft__head {
    flex-direction: row;
    align-items: flex-end;
}

.draft__title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(232, 226, 212);
}

.draft__cap {
    flex-grow: 1;
    padding-bottom: 3px;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(198, 158, 88);
    -unity-text-align: middle-right;
}

.draft__rule {
    height: 9px;
    margin: 8px 0 16px 0;
    background-image: url("Generated/ui-rule.png");
}

.draft__eyebrow {
    margin-right: 14px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(139, 147, 165);
}

.draft__foot {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
}

.team-row {
    flex-direction: row;
}

.spacer {
    flex-grow: 1;
}

/* ---------- the row above the board ---------- */

/* Which side you are on, and the code that gets somebody else onto one. Above the columns because
   both are decisions taken before the columns mean anything: picking a party is what makes a claim
   possible at all, and a code shared after the fight has started is a code shared too late. */
.draft__sides {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.code-card {
    flex-direction: row;
    align-items: center;
    padding: 6px 14px;
    background-image: url("Generated/ui-well.png");
    -unity-slice-left: 11;
    -unity-slice-right: 11;
    -unity-slice-top: 11;
    -unity-slice-bottom: 11;
}

.code-card__code {
    margin: 0 14px 0 4px;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(226, 191, 122);
}

/* ---------- the session bar ---------- */

.setup__players {
    margin-left: 16px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(139, 147, 165);
}

.ready-toggle {
    margin: 0 14px 0 0;
}

.ready-toggle .unity-toggle__text {
    margin-left: 8px;
    font-size: 12px;
    color: rgb(220, 224, 234);
}

/* ---------- party columns ---------- */

.parties {
    flex-grow: 1;
    flex-direction: row;
}

.party {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
    padding: 14px 12px 12px 12px;
    background-image: url("Generated/ui-panel.png");
    -unity-slice-left: 16;
    -unity-slice-right: 16;
    -unity-slice-top: 16;
    -unity-slice-bottom: 16;
}

/* The party the local player belongs to. Lit, because the whole screen is about picking a side and
   the one you picked should not take a second look to find. */
.party--mine {
    -unity-background-image-tint-color: rgb(190, 200, 220);
}

.party__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

/* A colour swatch rather than coloured text: the same colour is on the ring under each creature on
   the board, and a filled block is what matches a ring. */
.party__flag {
    width: 10px;
    height: 10px;
    margin-right: 8px;
}

.party__name {
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(232, 226, 212);
}

.party__count {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(139, 147, 165);
}

/* Clipped rather than crushed. A flex item shrinks by default, so a column holding more
   combatants than it has room for used to squeeze every card until the names drew outside them. */
.party__list {
    flex-grow: 1;
    margin-top: 6px;
    overflow: hidden;
}

.party__list > * {
    flex-shrink: 0;
}

.party__empty {
    padding: 14px 4px;
    font-size: 11px;
    color: rgb(100, 108, 126);
    white-space: normal;
}

.party__add {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.party__add > .dropdown {
    flex-grow: 1;
    margin: 0 6px 0 0;
}

/* ---------- combatant cards ---------- */

.fighter {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 5px;
    background-image: url("Generated/ui-card.png");
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
}

/* Someone is running this one. Unclaimed cards stay dim, so "who is actually playing" is legible
   across four columns without reading a word. */
.fighter--claimed {
    -unity-background-image-tint-color: rgb(170, 180, 200);
}

/* A character a player brought. It cannot be claimed or removed -- it is already someone's -- and
   the gold edge says so without a row of disabled buttons explaining it. */
.fighter--brought {
    -unity-background-image-tint-color: rgb(206, 176, 120);
}

.fighter--mine .fighter__name {
    color: rgb(240, 214, 160);
}

.fighter__body {
    flex-grow: 1;
    overflow: hidden;
}

.fighter__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(232, 226, 212);
    overflow: hidden;
    text-overflow: ellipsis;
}

.fighter__owner {
    margin-top: 1px;
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(130, 138, 156);
    overflow: hidden;
    text-overflow: ellipsis;
}

.fighter__owner--mine {
    color: rgb(198, 158, 88);
}

.fighter__actions {
    flex-direction: row;
}

/* ---------- buttons ---------- */

.button {
    height: 30px;
    margin: 0 0 0 6px;
    padding: 0 12px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(220, 224, 234);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Generated/ui-button.png");
    -unity-slice-left: 11;
    -unity-slice-right: 11;
    -unity-slice-top: 11;
    -unity-slice-bottom: 11;
    border-width: 0;
}

.button:hover {
    background-image: url("Generated/ui-button-hot.png");
}

.button:disabled {
    opacity: 0.3;
}

.button--primary {
    background-image: url("Generated/ui-button-primary.png");
    color: rgb(255, 244, 234);
}

/* A nudge, not a button with a word on it. Two of these plus Claim plus a remove cross is
   already more than a card this narrow wants, so they are as small as a finger allows. */
.level-step {
    width: 20px;
    height: 20px;
    margin: 0 0 0 3px;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(220, 224, 234);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Generated/ui-button.png");
    -unity-slice-left: 11;
    -unity-slice-right: 11;
    -unity-slice-top: 11;
    -unity-slice-bottom: 11;
    border-width: 0;
}

.level-step:hover {
    background-image: url("Generated/ui-button-hot.png");
}

.level-step:disabled {
    opacity: 0.25;
}

.button--compact {
    height: 24px;
    padding: 0 9px;
    font-size: 10px;
}

/* The side you are on. */
.button--chosen {
    background-image: url("Generated/ui-button-primary.png");
    color: rgb(255, 244, 234);
}

.dropdown {
    margin: 0;
}

.dropdown .unity-base-popup-field__input {
    height: 30px;
    padding-left: 10px;
    font-size: 11px;
    color: rgb(220, 224, 234);
    background-color: rgb(11, 13, 18);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(52, 59, 76);
}

.is-hidden {
    display: none;
}

/* Where a brought character fights, for the host. A chip per party, the current one ringed.

   Colour rather than a name: the column heading already says which party this card is in, so the
   only question left is where else it could go -- and four named buttons on a card this narrow was
   what made the old panel need a horizontal scrollbar. */
.party-chip {
    width: 14px;
    height: 14px;
    margin: 0 0 0 4px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    border-radius: 0;
    opacity: 0.4;
}

.party-chip:hover {
    opacity: 0.8;
}

.party-chip--current {
    opacity: 1;
    border-color: rgb(232, 226, 212);
}
