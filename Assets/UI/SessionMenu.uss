/* UI Toolkit stylesheet. USS is a subset of CSS: selectors, cascade and inheritance
   work as you'd expect, but layout is always flexbox and lengths are px or %. */

.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 14, 20, 0.55);
}

/* ---------- panels ---------- */

.panel {
    width: 420px;
    padding: 28px;
    border-radius: 14px;
    background-color: rgb(24, 27, 36);
    border-width: 1px;
    border-color: rgb(48, 53, 68);
}

.title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
    margin-bottom: 4px;
}

.subtitle {
    font-size: 13px;
    color: rgb(148, 158, 180);
    margin-bottom: 20px;
    white-space: normal;
}

/* ---------- fields ---------- */

.field-group {
    margin-bottom: 14px;
}

.field-label {
    font-size: 12px;
    color: rgb(148, 158, 180);
    margin-bottom: 6px;
}

.text-input {
    margin: 0;
}

.text-input .unity-base-text-field__input {
    height: 38px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 14px;
    color: rgb(240, 243, 250);
    background-color: rgb(16, 18, 25);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(56, 62, 80);
}

.text-input .unity-base-text-field__input:focus {
    border-color: rgb(226, 122, 63);
}

.text-input--code .unity-base-text-field__input {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
}

/* ---------- buttons ---------- */

.button {
    height: 42px;
    margin: 0;
    padding: 0 16px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(226, 232, 245);
    background-color: rgb(43, 49, 65);
    border-radius: 8px;
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.button:hover {
    background-color: rgb(56, 63, 82);
}

.button:disabled {
    opacity: 0.4;
}

.button--primary {
    background-color: rgb(198, 88, 38);
    color: rgb(255, 246, 240);
}

.button--primary:hover {
    background-color: rgb(226, 108, 52);
}

.button--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(56, 62, 80);
}

.button--compact {
    height: 32px;
    font-size: 12px;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 16px;
}

.button-row > .button {
    flex-grow: 1;
    flex-basis: 0;
}

/* USS has no structural pseudo-classes (:first-child etc.), so target by name. */
#leave-button {
    margin-right: 10px;
}

/* ---------- divider ---------- */

.divider {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 18px;
}

.divider__rule {
    flex-grow: 1;
    height: 1px;
    background-color: rgb(48, 53, 68);
}

.divider__label {
    font-size: 11px;
    color: rgb(110, 120, 142);
    margin: 0 10px;
}

/* ---------- lobby ---------- */

.code-card {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    margin-bottom: 18px;
    border-radius: 10px;
    background-color: rgb(16, 18, 25);
    border-width: 1px;
    border-color: rgb(48, 53, 68);
}

.code-card__code {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: rgb(240, 195, 120);
}

.player-list {
    height: 168px;
    margin-bottom: 14px;
    border-radius: 10px;
    background-color: rgb(16, 18, 25);
    border-width: 1px;
    border-color: rgb(48, 53, 68);
}

.player-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(32, 36, 48);
}

.player-row__name {
    font-size: 14px;
    color: rgb(226, 232, 245);
    overflow: hidden;
    text-overflow: ellipsis;
}

.player-row__tag {
    font-size: 11px;
    color: rgb(148, 158, 180);
    margin-left: 8px;
}

.player-row__state {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(148, 158, 180);
}

.player-row__state--ready {
    color: rgb(112, 200, 140);
}

.ready-toggle {
    margin: 0;
}

.ready-toggle .unity-toggle__text {
    font-size: 14px;
    color: rgb(226, 232, 245);
    margin-left: 8px;
}

/* ---------- status ---------- */

.status {
    margin-top: 14px;
    max-width: 420px;
    font-size: 12px;
    color: rgb(148, 158, 180);
    white-space: normal;
    -unity-text-align: middle-center;
}

.is-hidden {
    display: none;
}

/* ---------- menu screens ---------- */

.panel--wide {
    width: 520px;
}

.menu-stack {
    margin-top: 4px;
}

.button--menu {
    height: 46px;
    margin-bottom: 10px;
}

.back-button {
    margin-top: 18px;
}

/* ---------- settings ---------- */

.section-heading {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(110, 120, 142);
    margin-top: 18px;
    margin-bottom: 10px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.setting-row__label {
    width: 140px;
    font-size: 13px;
    color: rgb(200, 208, 224);
}

.setting-row__control {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
}

/* Fixed width and right alignment so the numbers do not shuffle the slider as they change. */
.setting-row__value {
    width: 52px;
    margin-left: 10px;
    font-size: 12px;
    color: rgb(148, 158, 180);
    -unity-text-align: middle-right;
}

.dropdown .unity-base-popup-field__input {
    height: 32px;
    padding-left: 10px;
    font-size: 13px;
    color: rgb(226, 232, 245);
    background-color: rgb(16, 18, 25);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(56, 62, 80);
}

.slider .unity-base-slider__tracker {
    height: 4px;
    background-color: rgb(16, 18, 25);
    border-width: 1px;
    border-color: rgb(48, 53, 68);
}

.slider .unity-base-slider__dragger {
    width: 16px;
    height: 16px;
    margin-top: -7px;
    border-radius: 8px;
    background-color: rgb(198, 88, 38);
    border-width: 0;
}

.setting-note {
    font-size: 11px;
    color: rgb(110, 120, 142);
    white-space: normal;
    margin-top: 2px;
}

/* Loud enough to be read before the player concludes the dropdowns are broken. */
.setting-note--warning {
    padding: 8px 10px;
    margin-top: 6px;
    margin-bottom: 4px;
    border-radius: 6px;
    color: rgb(240, 195, 120);
    background-color: rgba(240, 195, 120, 0.1);
    border-left-width: 2px;
    border-left-color: rgb(240, 195, 120);
}

/* ---------- start screen ---------- */

.start {
    align-items: center;
    justify-content: center;
}

.start__title {
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: rgb(240, 243, 250);
}

.start__prompt {
    margin-top: 18px;
    font-size: 14px;
    letter-spacing: 4px;
    color: rgb(148, 158, 180);
}

/* ---------- character list ---------- */

.character-list {
    height: 260px;
    margin: 8px 0 4px 0;
    border-radius: 10px;
    background-color: rgb(16, 18, 25);
    border-width: 1px;
    border-color: rgb(48, 53, 68);
}

.character-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(32, 36, 48);
}

.character-row--selected {
    background-color: rgba(198, 88, 38, 0.18);
}

.character-row__portrait {
    width: 44px;
    height: 44px;
    margin-right: 12px;
    border-radius: 6px;
    background-color: rgb(24, 27, 36);
    border-width: 1px;
    border-color: rgb(56, 62, 80);
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
}

.character-row__initial {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(200, 208, 224);
    -unity-text-align: middle-center;
}

.character-row__body {
    flex-grow: 1;
}

.character-row__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
}

.character-row__detail {
    font-size: 12px;
    color: rgb(148, 158, 180);
}

.character-row__invalid {
    font-size: 11px;
    color: rgb(226, 122, 63);
}

/* ---------- creator ---------- */

.panel--create {
    width: 760px;
}

.create-columns {
    flex-direction: row;
}

.create-form {
    flex-grow: 1;
    height: 380px;
    padding-right: 12px;
}

.create-summary {
    width: 236px;
    padding: 14px;
    border-radius: 10px;
    background-color: rgb(16, 18, 25);
    border-width: 1px;
    border-color: rgb(48, 53, 68);
}

.create-portrait {
    height: 132px;
    margin-bottom: 10px;
    border-radius: 8px;
    background-color: rgb(24, 27, 36);
    border-width: 1px;
    border-color: rgb(56, 62, 80);
    justify-content: center;
    -unity-background-scale-mode: scale-and-crop;
}

.create-portrait__initial {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(90, 98, 118);
    -unity-text-align: middle-center;
}

.create-summary__name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
}

.create-summary__class {
    font-size: 12px;
    color: rgb(148, 158, 180);
    margin-bottom: 10px;
    white-space: normal;
}

.create-stats {
    margin-bottom: 6px;
}

.resolved-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 0;
}

.resolved-row__label {
    font-size: 12px;
    color: rgb(148, 158, 180);
}

.resolved-row__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(226, 232, 245);
}

/* The pool wraps: a level-eight character is eight chips and the column is narrow. */
.create-pool {
    flex-direction: row;
    flex-wrap: wrap;
}

.pool-chip {
    padding: 3px 8px;
    margin: 0 4px 4px 0;
    border-radius: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: rgb(24, 27, 36);
    border-width: 1px;
}

.pool-chip--empty {
    color: rgb(90, 98, 118);
    border-color: rgb(48, 53, 68);
}

/* ---------- creator form rows ---------- */

.alloc-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.alloc-row__label {
    width: 96px;
    font-size: 13px;
    color: rgb(200, 208, 224);
}

.alloc-row__effect {
    flex-grow: 1;
    font-size: 11px;
    color: rgb(110, 120, 142);
}

.alloc-row__value {
    width: 34px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
    -unity-text-align: middle-center;
}

.step-button {
    width: 28px;
    height: 28px;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(226, 232, 245);
    background-color: rgb(43, 49, 65);
    border-radius: 6px;
    border-width: 0;
}

.step-button:hover {
    background-color: rgb(56, 63, 82);
}

.step-button:disabled {
    opacity: 0.3;
}

.budget-line {
    font-size: 12px;
    color: rgb(148, 158, 180);
    margin-bottom: 10px;
}

.budget-line--over {
    color: rgb(226, 122, 63);
    -unity-font-style: bold;
}

.element-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.element-button {
    height: 32px;
    padding: 0 12px;
    margin: 0 6px 6px 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(226, 232, 245);
    background-color: rgb(43, 49, 65);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(56, 62, 80);
}

.element-button:hover {
    background-color: rgb(56, 63, 82);
}

.create-faults {
    min-height: 18px;
    margin-top: 6px;
    font-size: 12px;
    color: rgb(226, 122, 63);
    white-space: normal;
}

.portrait-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.portrait-row > .text-input {
    flex-grow: 1;
    margin-right: 8px;
}

/* Who you are playing as, on the main menu. Small, because it is a reminder rather than a control. */
.playing-as {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    margin-bottom: 16px;
    border-radius: 8px;
    background-color: rgb(16, 18, 25);
    border-width: 1px;
    border-color: rgb(48, 53, 68);
}

.playing-as__name {
    font-size: 13px;
    color: rgb(200, 208, 224);
}
