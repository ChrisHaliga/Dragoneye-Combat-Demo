/* The menu's look.

   USS is a subset of CSS: selectors, cascade and inheritance work as you would expect, but layout
   is always flexbox and lengths are px or %. There are no gradients, no shadows and no bevels --
   so everything with depth in it is a nine-sliced image baked by UiArtSetup, and this file only
   places them.

   Two archetypes. A stage uses the whole window: a head with a title and a gold rule, a body of
   columns, and a foot of actions pinned to the bottom. A dialog centres a single plate for the
   handful of screens that really are one question. Nothing is a narrow card floating in an empty
   window. */

/* ---------- foundation ---------- */

.root {
    flex-grow: 1;
    background-image: url("Generated/ui-backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* Screens are stacked on the same spot and swapped by class, so the layout never reflows when one
   is shown -- and a screen can use the full frame without fighting the ones behind it. */
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen--centre {
    align-items: center;
    justify-content: center;
}

.is-hidden {
    display: none;
}

.spacer {
    flex-grow: 1;
}

/* ---------- the gold rule ---------- */

.rule {
    height: 9px;
    margin: 10px 0;
    background-image: url("Generated/ui-rule.png");
}

.rule--long {
    width: 520px;
    margin: 18px 0;
}

.rule--head {
    margin: 0 56px 12px 56px;
}

/* ---------- stages ---------- */

.stage {
    padding: 20px 0 0 0;
}

.stage__head {
    flex-direction: row;
    align-items: flex-end;
    padding: 0 56px;
}

.stage__title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(232, 226, 212);
}

.stage__note {
    flex-grow: 1;
    margin-left: 18px;
    padding-bottom: 4px;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(139, 147, 165);
    -unity-text-align: middle-right;
}

/* Which page of a wizard this is, between the title and any fault. */
.stage__steps {
    margin-left: 18px;
    padding-bottom: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(198, 158, 88);
}

.stage__fault {
    flex-grow: 1;
    margin-left: 18px;
    padding-bottom: 4px;
    font-size: 12px;
    color: rgb(226, 122, 63);
    white-space: normal;
    -unity-text-align: middle-right;
}

.stage__body {
    flex-grow: 1;
    flex-direction: row;
    padding: 0 56px;
}

.stage__body--centred {
    justify-content: center;
}

.stage__foot {
    flex-direction: row;
    align-items: center;
    padding: 14px 56px 18px 56px;
}

/* ---------- the title card ---------- */

.start {
    align-items: center;
}

.start__title {
    font-size: 78px;
    -unity-font-style: bold;
    letter-spacing: 20px;
    /* The letterspacing is applied after the last character too, so the word sits off-centre
       without pulling it back by half a space. */
    margin-left: 20px;
    color: rgb(236, 231, 219);
}

.start__sub {
    font-size: 14px;
    letter-spacing: 12px;
    margin-left: 12px;
    color: rgb(198, 158, 88);
}

.start__prompt {
    margin-top: 54px;
    font-size: 12px;
    letter-spacing: 5px;
    color: rgb(120, 128, 146);
}

/* ---------- home ---------- */

.home {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding: 0 90px 40px 90px;
}

.home__left {
    width: 400px;
}

.home__sub {
    margin: -2px 0 22px 4px;
    font-size: 11px;
    letter-spacing: 8px;
    color: rgb(198, 158, 88);
}

.home__mark {
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: rgb(236, 231, 219);
}

.home__right {
    flex-grow: 1;
    align-items: flex-end;
}

.menu-stack {
    margin-top: 10px;
}

.hero {
    width: 360px;
    padding: 28px 28px 24px 28px;
    background-image: url("Generated/ui-panel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

.hero__name {
    margin: 6px 0 4px 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(232, 226, 212);
    white-space: normal;
}

.hero__body {
    margin-bottom: 18px;
}

.hero__portrait {
    width: 100%;
    height: 240px;
    margin-bottom: 14px;
}

.hero__class {
    margin-bottom: 6px;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(198, 158, 88);
    white-space: normal;
}

/* ---------- type ---------- */

.eyebrow {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(198, 158, 88);
}

.col__title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(198, 158, 88);
    margin-bottom: 6px;
}

.col__title--spaced {
    margin-top: 8px;
}

.field-label {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(139, 147, 165);
    margin-bottom: 4px;
}

/* Kept for the settings note and anything else that used the old name. */
.section-heading {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(198, 158, 88);
    margin-top: 18px;
    margin-bottom: 10px;
}

/* ---------- buttons ---------- */

.btn {
    height: 40px;
    margin: 0 0 0 10px;
    padding: 0 20px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(220, 224, 234);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Generated/ui-button.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

.btn:hover {
    background-image: url("Generated/ui-button-hot.png");
    color: rgb(245, 247, 252);
}

.btn:disabled {
    opacity: 0.35;
}

.btn--primary {
    background-image: url("Generated/ui-button-primary.png");
    color: rgb(255, 244, 234);
}

.btn--primary:hover {
    background-image: url("Generated/ui-button-primary.png");
    color: rgb(255, 255, 255);
}

.btn--ghost {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(139, 147, 165);
}

.btn--ghost:hover {
    background-image: url("Generated/ui-button.png");
    color: rgb(220, 224, 234);
}

.btn--compact {
    height: 30px;
    padding: 0 14px;
    font-size: 11px;
}

.btn--wide {
    width: 200px;
}

.btn--block {
    margin: 0 0 10px 0;
    height: 44px;
}

.btn--menu {
    height: 46px;
    width: 100%;
    margin: 0 0 2px 0;
    font-size: 18px;
    letter-spacing: 3px;
    -unity-text-align: middle-left;
    padding-left: 22px;
    color: rgb(178, 184, 200);
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: border-left-color, padding-left, color, background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.btn--menu:hover {
    color: rgb(255, 244, 234);
    padding-left: 30px;
    border-left-color: rgb(226, 191, 122);
    background-image: none;
    background-color: rgba(198, 158, 88, 0.08);
}

.btn--menu:active {
    scale: 1;
    padding-left: 28px;
}

/* The one that starts a game is gold from the start; it is what the screen is for. */
.btn--menu.btn--primary {
    color: rgb(226, 191, 122);
    background-image: none;
}

.btn--menu.btn--primary:hover {
    color: rgb(255, 232, 190);
    background-image: none;
}

.btn--menu.btn--ghost {
    margin-top: 14px;
    font-size: 15px;
    color: rgb(120, 128, 146);
}

.btn--menu:disabled {
    opacity: 0.3;
}

/* ---------- panels and wells ---------- */

.panel-skin {
    background-image: url("Generated/ui-panel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

.well {
    background-image: url("Generated/ui-well.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
}

/* ---------- the character rail ---------- */

.rail {
    width: 340px;
    flex-shrink: 0;
    margin-right: 26px;
}

.rail__list {
    flex-grow: 1;
    padding: 8px;
    background-image: url("Generated/ui-well.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
}

.rail__new {
    margin: 12px 0 0 0;
    height: 42px;
}

.character-row {
    flex-direction: row;
    align-items: center;
    padding: 12px;
    margin-bottom: 6px;
    background-image: url("Generated/ui-card.png");
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
}

.character-row:hover {
    -unity-background-image-tint-color: rgb(150, 160, 185);
}

/* The selected row is lit rather than merely tinted: it is the one thing on the screen the rest of
   the panel is describing, so it has to win. */
.character-row--selected {
    border-width: 2px;
    border-color: rgb(226, 191, 122);
    -unity-background-image-tint-color: rgb(214, 196, 170);
}

.character-row--selected:hover {
    -unity-background-image-tint-color: rgb(236, 216, 186);
}

.character-row {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.character-row__portrait {
    width: 52px;
    height: 52px;
    margin-right: 14px;
    background-image: url("Generated/ui-well.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
}

.character-row__initial {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(120, 128, 146);
    -unity-text-align: middle-center;
}

.character-row__body {
    flex-grow: 1;
}

.character-row__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
}

.character-row__detail {
    margin-top: 2px;
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(139, 147, 165);
}

.character-row__invalid {
    margin-top: 2px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(226, 122, 63);
}

/* ---------- the character sheet ---------- */

.sheet {
    flex-grow: 1;
    flex-basis: 0;
    padding: 30px 34px;
    background-image: url("Generated/ui-panel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

.sheet__head {
    flex-direction: row;
}

.sheet__name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
}

.sheet__class {
    margin-top: 2px;
    font-size: 12px;
    letter-spacing: 2px;
    color: rgb(198, 158, 88);
    white-space: normal;
}

.sheet__blurb {
    margin-top: 12px;
    font-size: 12px;
    color: rgb(139, 147, 165);
    white-space: normal;
}

.sheet__empty {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 13px;
    color: rgb(90, 98, 118);
}

/* Where the character started and where it ended, in one line, because that is the whole news.
   Three levels at once is one heading rather than three identical screens. */
.levelup__arc {
    margin-top: 6px;
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(226, 191, 122);
    white-space: normal;
}

.sheet-scroll {
    flex-grow: 1;
    flex-basis: 0;
}

/* The columns share what the sheet has left, and no more. Without the minimum a flex item is at
   least as tall as its own content, so a long skill list pushed itself out of the panel rather
   than scrolling inside it. */
.sheet__columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin-top: 6px;
}

.sheet__column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 26px;
}

.sheet__column--scrolls {
    min-height: 0;
}

.sheet__scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* Lines wrap and never shrink, so a long description is read rather than squeezed. */
.sheet__scroll .unity-scroll-view__content-container > * {
    flex-shrink: 0;
}

/* ---------- portraits ---------- */

.portrait {
    background-image: url("Generated/ui-well.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
}

.portrait--large {
    width: 100%;
    height: 108px;
}

/* The faces this species can wear. A wrap of thumbnails rather than a dropdown, because choosing a
   picture from a list of names is choosing blind. */
.portrait-picker {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.portrait-choice {
    width: 36px;
    height: 36px;
    margin: 0 6px 6px 0;
    border-width: 2px;
    border-color: rgb(46, 52, 68);
    -unity-background-scale-mode: scale-and-crop;
}

.portrait-choice:hover {
    border-color: rgb(96, 108, 134);
}

/* The one being worn. A gold edge, the same "this is the chosen one" the rest of the menu uses. */
.portrait-choice--chosen {
    border-color: rgb(226, 191, 122);
}

.portrait--sheet {
    width: 150px;
    height: 180px;
    margin-right: 24px;
}

.portrait__initial {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(72, 80, 98);
    -unity-text-align: middle-center;
}

.portrait__controls {
    flex-direction: row;
    margin-top: 8px;
}

.portrait__controls > .btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 0 0 8px;
}

.portrait__controls > .btn:disabled {
    opacity: 0.3;
}

/* ---------- creator columns ---------- */

/* Fixed columns are genuinely fixed, and only the sheet flexes.

   `flex-basis` beats `width` on the main axis, so a shared `flex-basis: 0` here would give every
   column a base size of zero -- and the three that do not grow would then collapse to their
   content, which is precisely what happened: three crushed strips of overlapping labels and a
   sheet stretched across the whole window. Width alone is not enough either; a flex item shrinks
   by default, so each one also has to refuse to. */
.col {
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 26px;
}

/* Nothing inside a column may be squeezed to make the column fit.

   A flex item shrinks by default, and in a column that shrinks its *height*. So a column running
   even slightly over its space did not clip or scroll -- every card in it silently lost height
   while the text inside kept its own, and the text drew outside its frame. That is what "the stats
   do not fit in their boxes" was: not a box too small for its text, but a box crushed by its
   parent, with the well image squashed to a letterbox and the number hanging out underneath.

   Refusing to shrink turns a column that does not fit into one that is visibly clipped, which is a
   bug that can be seen and measured rather than one that quietly mangles every frame on screen. */
.col > *,
.group > *,
.statline > .stat,
.sheet__column > *,
.attr-grid > .attr {
    flex-shrink: 0;
}

.col--identity {
    width: 230px;
}

.col--attributes {
    width: 240px;
}

.col--kit {
    width: 270px;
}

/* The one column that takes whatever is left.

   Clipped, so a class with an unusually long skill list spills inside the frame rather than out
   the bottom of it. Everything authored today fits. */
.col--sheet {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    overflow: hidden;
    padding: 18px;
    margin-right: 0;
    background-image: url("Generated/ui-panel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

.col--settings {
    flex-grow: 0;
    width: 420px;
    padding: 26px;
    margin: 0 13px;
    background-image: url("Generated/ui-panel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

.group {
    margin-bottom: 4px;
}

/* ---------- fields ---------- */

.field-group {
    margin-bottom: 6px;
}

.text-input {
    margin: 0;
}

/* Tall enough for the descenders. A 14px line in a 34px box was clipping the tails off g and y,
   because the inner text element is sized to the font and then centred in whatever is left. */
.text-input .unity-base-text-field__input {
    height: 38px;
    padding: 4px 12px;
    font-size: 14px;
    color: rgb(236, 231, 219);
    background-color: rgb(11, 13, 18);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(52, 59, 76);
}

.text-input .unity-base-text-field__input:focus {
    border-color: rgb(198, 158, 88);
}

/* The same box and the same size as every other field: a join code is six characters, not a
   headline, and 22px with eight of letter-spacing did not fit the box it was given. What sets it
   apart is the colour and the spacing between the characters, which is what makes a code easy to
   read aloud. */
.text-input--code .unity-base-text-field__input {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    color: rgb(226, 191, 122);
}

.dropdown {
    margin: 0;
}

.dropdown .unity-base-popup-field__input {
    height: 32px;
    padding-left: 12px;
    font-size: 13px;
    color: rgb(220, 224, 234);
    background-color: rgb(11, 13, 18);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(52, 59, 76);
}

.dropdown .unity-base-popup-field__input:hover {
    border-color: rgb(96, 108, 134);
}

/* ---------- attribute allocation ---------- */

/* Heights are minimums, never fixed, on everything that holds text. A fixed height is a promise
   about font metrics that the stylesheet is in no position to make, and when it is wrong the text
   simply draws outside its own frame. */
.alloc-row {
    flex-direction: row;
    align-items: center;
    min-height: 30px;
    padding: 4px 10px;
    margin-bottom: 2px;
    background-image: url("Generated/ui-card.png");
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
}

.alloc-row__label {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(198, 158, 88);
}

.alloc-row__value {
    width: 34px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
    -unity-text-align: middle-center;
}

.step-button {
    width: 20px;
    height: 20px;
    padding: 0;
    margin: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(220, 224, 234);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Generated/ui-button.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

.step-button:hover {
    background-image: url("Generated/ui-button-hot.png");
}

.step-button:disabled {
    opacity: 0.25;
}

.budget {
    margin-bottom: 10px;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(139, 147, 165);
}

.budget--over {
    color: rgb(226, 122, 63);
    -unity-font-style: bold;
}

.budget--spent {
    color: rgb(198, 158, 88);
}

/* ---------- elements ---------- */

/* A row per element rather than a wrap of pills: seven is a fixed set, and a fixed set laid out in
   a fixed order is read as a hand of resources instead of a bag of tags. */
.element-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding: 2px 8px;
    margin-bottom: 2px;
    background-image: url("Generated/ui-card.png");
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
}

.element-row__gem {
    width: 18px;
    height: 18px;
    margin-right: 10px;
    background-image: url("Generated/ui-gem.png");
}

.element-row__name {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(200, 206, 220);
}

.element-row__value {
    width: 28px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
    -unity-text-align: middle-center;
}

.element-row--empty .element-row__gem {
    opacity: 0.22;
}

.element-row--empty .element-row__name {
    color: rgb(100, 108, 126);
}

.element-row--empty .element-row__value {
    color: rgb(84, 92, 110);
}

/* A read-only run of gems, for the sheet. Each gem carries its count, so a pool of four Hydro is
   one gem reading "4" rather than four identical chips. */
.gem-row {
    flex-direction: row;
    flex-wrap: wrap;
}

/* One element and how much of it is held. The rune is set inline from the icon library; the gem
   below it is what shows through when a project has no art for that element yet. */
.element-chip {
    flex-direction: row;
    align-items: center;
    margin: 0 10px 5px 0;
}

.element-chip__mark {
    width: 26px;
    height: 26px;
    background-image: url("Generated/ui-gem.png");
    -unity-background-scale-mode: scale-to-fit;
}

.element-chip__count {
    margin-left: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(226, 222, 210);
}

/* Nothing held, still drawn so the row does not change width as a fight goes on. */
.element-chip--none {
    opacity: 0.22;
}

.gem-row__empty {
    font-size: 11px;
    color: rgb(100, 108, 126);
}

/* ---------- stats ---------- */

/* Four numbers, big, in a row of wells. These are the character, and they were previously a list of
   label-and-value lines indistinguishable from the settings screen. */
.statline {
    flex-direction: row;
    margin: 12px 0 4px 0;
}

.stat {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
    padding: 4px 2px 5px 2px;
    max-height: 54px;
    align-items: center;
    background-image: url("Generated/ui-well.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
}

.stat__label {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(139, 147, 165);
}

.stat__value {
    margin-top: 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
}

/* ---------- experience ---------- */

.xp {
    margin: 6px 0 2px 0;
}

.xp-track {
    height: 7px;
    background-color: rgb(24, 27, 35);
    border-width: 1px;
    border-color: rgb(52, 59, 76);
    overflow: hidden;
}

.xp-fill {
    height: 100%;
    background-color: rgb(120, 148, 200);
}

/* Enough to level. Gold, because it is the same "there is a decision waiting" the menu uses
   everywhere else, and a full blue bar reads as merely finished. */
.xp-fill--ready {
    background-color: rgb(226, 191, 122);
}

.xp-label {
    margin-top: 3px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(120, 128, 146);
}

.xp-label--ready {
    color: rgb(226, 191, 122);
}

/* The seven resolved attributes, wrapped into a grid of small tiles.

   Resolved rather than bought: the middle column already shows what the player is spending, and the
   difference between the two is the species baseline and the kit, which is the thing worth seeing
   here. */
.attr-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.attr {
    width: 14.2%;
    padding: 2px 0;
    align-items: center;
}

.attr__label {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(139, 147, 165);
}

.attr__value {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(220, 224, 234);
}

/* Raised above what was bought: something -- a species, a sword -- is adding to it. */
.attr--boosted .attr__value {
    color: rgb(198, 158, 88);
}

.attr--reduced .attr__value {
    color: rgb(196, 108, 84);
}

/* ---------- readouts and skills ---------- */

.resolved-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 0;
}

.resolved-row__label {
    font-size: 12px;
    color: rgb(139, 147, 165);
}

.resolved-row__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(220, 224, 234);
}

/* Name and price on one line, what it does under them. A column, because the description is a
   sentence and a sentence does not belong on the end of a row. */
.skill-line {
    flex-direction: column;
    min-height: 24px;
    padding: 3px 8px;
    margin-bottom: 1px;
    background-image: url("Generated/ui-card.png");
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
}

/* The name gives way and the cost does not: a skill with a long name is still identifiable from
   its first few words, but "1 AP" with a letter missing is unreadable. */
.skill-line__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.skill-line__text {
    margin-top: 1px;
    font-size: 10px;
    white-space: normal;
    color: rgb(146, 154, 172);
}

.skill-line__name {
    flex-shrink: 1;
    font-size: 12px;
    color: rgb(220, 224, 234);
    overflow: hidden;
    text-overflow: ellipsis;
}

.skill-line__cost {
    flex-shrink: 0;
    margin-left: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(198, 158, 88);
}

.skill-line--none {
    font-size: 11px;
    color: rgb(100, 108, 126);
    white-space: normal;
    background-image: none;
    padding: 0;
    min-height: 0;
}

.passive-line {
    margin-top: 6px;
    font-size: 11px;
    color: rgb(198, 158, 88);
    white-space: normal;
}

/* ---------- dialogs ---------- */

.dialog {
    width: 460px;
    padding: 32px 34px 30px 34px;
    background-image: url("Generated/ui-panel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

.dialog__title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: rgb(236, 231, 219);
}

.dialog__note {
    margin-bottom: 20px;
    font-size: 12px;
    color: rgb(139, 147, 165);
    white-space: normal;
}

/* ---------- settings ---------- */

.setting-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.setting-row__label {
    width: 130px;
    font-size: 12px;
    color: rgb(200, 206, 220);
}

.setting-row__control {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
}

/* Fixed width and right aligned so the numbers do not shuffle the slider as they change. */
.setting-row__value {
    width: 52px;
    margin-left: 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(198, 158, 88);
    -unity-text-align: middle-right;
}

.slider .unity-base-slider__tracker {
    height: 3px;
    background-color: rgb(11, 13, 18);
    border-width: 1px;
    border-color: rgb(42, 48, 62);
}

.slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    margin-top: -6px;
    border-radius: 0;
    background-color: rgb(198, 158, 88);
    border-width: 0;
}

.setting-note {
    font-size: 11px;
    color: rgb(100, 108, 126);
    white-space: normal;
    margin-top: 6px;
}

/* Loud enough to be read before the player concludes the dropdowns are broken. */
.setting-note--warning {
    padding: 10px 12px;
    margin-top: 8px;
    color: rgb(226, 191, 122);
    background-color: rgba(198, 158, 88, 0.1);
    border-left-width: 2px;
    border-left-color: rgb(198, 158, 88);
}

/* ---------- status ---------- */

.status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    font-size: 12px;
    color: rgb(139, 147, 165);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- motion ---------- */

/* Every button eases, and every button gives under the pointer. The hover swaps a frame image,
   which cannot ease and does not need to -- hover is expected to be immediate. The press is the
   part that was missing: a control that does not move when it is clicked is a control the player
   is not sure they clicked. */
.btn,
.step-button,
.character-row,
.portrait-choice {
    transition-property: scale, color, opacity, -unity-background-image-tint-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.btn:active,
.step-button:active,
.portrait-choice:active {
    scale: 0.97;
}

.character-row:active {
    scale: 0.99;
}

/* Screens arrive rather than appear. Opacity and a short rise, so a change of screen reads as a
   change of place and not as a flicker. Nothing fades out: the next screen is what the player
   asked for and it should not wait on the one they left. */
.screen {
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.screen--in {
    opacity: 1;
    translate: 0 0;
}

/* The title card breathes. A prompt that sits perfectly still on a title screen looks like a label;
   one that slowly rises and falls looks like an invitation. */
.start__prompt {
    transition-property: opacity;
    transition-duration: 1.1s;
    transition-timing-function: ease-in-out;
}

.start__prompt--dim {
    opacity: 0.35;
}

/* ---------- test mode ---------- */

.test-list {
    padding: 8px 12px;
    background-image: url("Generated/ui-well.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
}

.test-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(139, 147, 165, 0.22);
}

.test-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 16px;
}

.test-row__title {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(232, 226, 214);
}

.test-row__summary {
    margin-top: 2px;
    font-size: 12px;
    white-space: normal;
    color: rgb(139, 147, 165);
}

.test-row__status {
    margin-top: 4px;
    font-size: 11px;
    letter-spacing: 1px;
}

.test-row__status--pass {
    color: rgb(126, 196, 138);
}

.test-row__status--fail {
    color: rgb(214, 96, 84);
}

.test-row__failure {
    margin-top: 2px;
    font-size: 11px;
    white-space: normal;
    color: rgb(214, 96, 84);
}

/* ---------- the creator's pages ---------- */

/* A page is a stage body that can be swapped for the next. */
.page {
    flex-grow: 1;
}

/* What a page is asking, under its title, in one sentence. */
.page__lead {
    margin-bottom: 10px;
    font-size: 12px;
    white-space: normal;
    color: rgb(139, 147, 165);
}

.col--wide {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 0;
}

.col--classes {
    width: 300px;
}

.col--attributes-tall {
    width: 330px;
}

/* A species, as a card: what it is called, what it is, what it gives. */
.choice-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.choice-card {
    width: 300px;
    min-height: 96px;
    margin: 0 12px 12px 0;
    padding: 12px 14px;
    background-image: url("Generated/ui-card.png");
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.choice-card:hover {
    -unity-background-image-tint-color: rgb(150, 160, 185);
}

.choice-card--chosen {
    border-color: rgb(226, 191, 122);
    -unity-background-image-tint-color: rgb(214, 196, 170);
}

.choice-card__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
}

.choice-card__text {
    margin-top: 3px;
    font-size: 11px;
    white-space: normal;
    color: rgb(150, 158, 176);
}

.choice-card__line {
    margin-top: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(198, 158, 88);
    white-space: normal;
}

/* A class, as a row down the left: name and one line, chosen in gold. */
.class-list {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.class-list .unity-scroll-view__content-container > * {
    flex-shrink: 0;
}

/* The face on the overview: smaller than the roster's, since the sheet under it is the point. */
.portrait--overview {
    width: 110px;
    height: 132px;
    margin-right: 20px;
}

.class-row {
    align-items: flex-start;
    min-height: 40px;
    margin: 0 0 3px 0;
    padding: 5px 12px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Generated/ui-card.png");
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.class-row:hover {
    -unity-background-image-tint-color: rgb(150, 160, 185);
}

.class-row--chosen {
    border-color: rgb(226, 191, 122);
    -unity-background-image-tint-color: rgb(214, 196, 170);
}

.class-row__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
}

.class-row__blurb {
    margin-top: 1px;
    font-size: 10px;
    white-space: normal;
    color: rgb(139, 147, 165);
}

.class-detail__name {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(236, 231, 219);
}

.class-detail__text {
    margin-top: 4px;
    font-size: 12px;
    white-space: normal;
    color: rgb(178, 184, 200);
}

.class-detail__line {
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 1px;
    white-space: normal;
    color: rgb(198, 158, 88);
}

/* An attribute row with what a point in it buys written under the steppers. */
.alloc-row--tall {
    flex-direction: column;
    align-items: stretch;
    padding: 4px 10px 5px 10px;
}

.alloc-row__line {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
}

.alloc-row__text {
    margin-top: 2px;
    font-size: 10px;
    white-space: normal;
    color: rgb(139, 147, 165);
}

/* What the chosen item is, under its dropdown. */
.field-note {
    margin-top: 4px;
    font-size: 10px;
    white-space: normal;
    color: rgb(139, 147, 165);
}

/* The sheet's head, laid out beside the face. */
.sheet__titles {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Columns that only hold what fits, in the creator's overview, which scrolls as a whole. */
.sheet__columns--flat {
    flex-grow: 0;
}

/* The one being played as, said on the row. */
.character-row__playing {
    margin-top: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(226, 191, 122);
}

/* An empty slot on the sheet, dimmer than what is carried. */
.kit-line--empty {
    opacity: 0.55;
}
