<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root" class="hud-root">
        <Style src="ArenaHud.uss" />
        <Style src="Chrome.uss" />

        <!-- The turn order, across the top. One card per creature in the order they act, the one
             acting now larger and named. Nothing else: whose turn it is is the card that grew. -->
        <ui:VisualElement name="turn-bar" class="turn-bar">
            <ui:VisualElement name="turn-order" class="turn-bar__order" />
        </ui:VisualElement>

        <!-- The bottom band: what the turn is spent out of over what it is spent on. Points above
             health, End Turn on the right of it, and the bar of actions under the pair. -->
        <ui:VisualElement name="turn-footer" class="turn-footer">
            <ui:Label name="turn-announce" text="" class="turn-announce" />

            <ui:VisualElement class="vitals">
                <ui:VisualElement class="vitals__row">
                    <ui:VisualElement class="vitals__gutter" picking-mode="Ignore" />
                    <ui:VisualElement name="ap-row" class="ap-row">
                        <ui:VisualElement name="ap-pips" class="pips pips--footer" />
                        <ui:Label name="ap-text" text="" class="ap-row__text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="vitals__gutter" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement class="vitals__row">
                    <ui:VisualElement class="vitals__gutter" picking-mode="Ignore" />
                    <ui:VisualElement name="own-vitals" class="own-vitals">
                        <ui:VisualElement name="own-health" class="own-health">
                            <ui:VisualElement name="own-health-fill" class="own-health__fill" />
                            <ui:Label name="own-health-text" text="" class="own-health__text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="end-turn-button" text="End Turn" class="button end-turn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="action-row">
                <ui:VisualElement name="action-menu" class="action-menu">
                    <ui:Button name="menu-equipment" class="action-menu__button" />
                    <ui:Button name="menu-skills" class="action-menu__button" />
                    <ui:Button name="menu-items" class="action-menu__button" />
                </ui:VisualElement>

                <ui:VisualElement name="skill-bar" class="action-bar" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="cursor-action" text="" class="cursor-action" />

        <!-- Numbers that rise off a creature and fade. Positioned from the world every frame, so
             the layer is a full-screen canvas with nothing of its own in it. -->
        <!-- What this player is holding, always on screen. Four rows of two, bottom right,
             out of the way of the board and beside the hand it describes. -->
        <ui:VisualElement name="own-elements" class="own-elements" />

        <ui:VisualElement name="floating-text" class="floating-layer" picking-mode="Ignore" />

        <ui:VisualElement name="scenario-report" class="scenario-report is-hidden">
            <ui:Label name="scenario-title" text="" class="scenario-report__title" />
            <ui:Label name="scenario-status" text="" class="scenario-report__status" />
            <ui:ScrollView name="scenario-checks" class="scenario-report__checks" />
            <ui:VisualElement class="scenario-report__buttons">
                <ui:Button name="scenario-next-button" text="Next scenario" class="button" />
                <ui:Button name="scenario-back-button" text="Back to test mode" class="button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="outcome-banner" class="outcome is-hidden">
            <ui:Label name="outcome-title" text="" class="outcome__title" />
            <ui:Label name="outcome-note" text="Returning to the menu..." class="outcome__note" />
        </ui:VisualElement>

        <!-- The party, floating. No frame, no heading: the cards are the panel. -->
        <ui:VisualElement name="party-column" class="party-column">
            <ui:ScrollView name="portrait-list" class="portrait-list" />
        </ui:VisualElement>

        <!-- What has happened, in order, in two sizes. Shut it and the last line stays as a
             sliver above the bar; open it and it is the whole record, scrollable. -->
        <ui:VisualElement name="combat-log" class="combat-log combat-log--small">
            <ui:VisualElement name="combat-log-frame" class="combat-log__frame">
                <ui:VisualElement class="combat-log__head">
                    <ui:Label text="COMBAT LOG" class="combat-log__title" />
                    <ui:Button name="combat-log-minimize" class="icon-button" />
                </ui:VisualElement>
                <ui:ScrollView name="combat-log-list" class="combat-log-list" />
            </ui:VisualElement>

            <ui:Button name="combat-log-sliver" class="combat-log__sliver" />
        </ui:VisualElement>

        <!-- One skill, in full, because a slot is an icon and an icon is not a rulebook. Opened
             from the slot's own right-click menu and closed from the corner. -->
        <ui:VisualElement name="skill-window" class="skill-window is-hidden">
            <ui:VisualElement class="skill-window__head">
                <ui:Label name="skill-window-name" text="" class="skill-window__name" />
                <ui:Button name="skill-window-close" class="icon-button" />
            </ui:VisualElement>
            <ui:Label name="skill-window-cost" text="" class="skill-window__cost" />
            <ui:Label name="skill-window-text" text="" class="skill-window__text" />
            <ui:VisualElement name="skill-window-stats" class="skill-window__stats" />
        </ui:VisualElement>

        <!-- Everything below the party line scrolls: a level-six creature carries more skills and
             elements than a card can show, and the card is not allowed to grow past the HUD. -->
        <ui:VisualElement name="summary-card" class="card is-hidden">

            <ui:VisualElement class="card__corner">
                <ui:Button name="card-pin" class="icon-button" />
                <ui:Button name="card-close" class="icon-button" />
            </ui:VisualElement>

            <!-- Which side, first and in that side's colour. It is the thing a player checks before
                 anything else on the card, and it was buried three lines down. -->
            <ui:Label name="card-party" text="" class="card__party" />

            <ui:ScrollView name="card-scroll" class="card__scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">

            <ui:VisualElement class="card__head">
                <ui:VisualElement name="card-portrait" class="card__portrait" />
                <ui:VisualElement class="card__titles">
                    <ui:Label name="card-name" text="Name" class="card__name" />
                    <ui:Label name="card-subtitle" text="Species - Class - Party" class="card__subtitle" />
                    <ui:Label name="card-controller" text="Controlled by" class="card__controller" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="card-description" text="" class="card__description" />

            <ui:VisualElement class="card__stats">
                <ui:VisualElement name="card-armour-row" class="stat-row">
                    <ui:Label text="ARM" class="stat-row__label" />
                    <ui:Label name="card-armour" text="0 / 0" class="stat-row__value stat-row__value--armour" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="HP" class="stat-row__label" />
                    <ui:Label name="card-hp" text="0 / 0" class="stat-row__value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="AP" class="stat-row__label" />
                    <ui:VisualElement name="card-ap-pips" class="pips" />
                    <ui:Label name="card-ap" text="0 / 0" class="stat-row__value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="SPD" class="stat-row__label" />
                    <ui:Label name="card-speed" text="0" class="stat-row__value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="card-xp" class="xp" />

            <ui:VisualElement class="card__rule" />

            <ui:Label name="card-elements-title" text="" class="card__elements-title" />
            <ui:VisualElement name="card-elements" class="card__elements" />

            <!-- What this creature has been watched doing. The log names skills; this is where you
                 look one up. -->
            <ui:VisualElement class="card__rule" />

            <ui:Label name="card-skills-title" text="" class="card__elements-title" />
            <ui:VisualElement name="card-skills" class="card__skills" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
