/* Arena HUD. Party column upper-left, summary card upper-right -- the Baldur's Gate / Pillars
   layout, where the portrait column and its health readout live together on the left.

   Dressed in the same generated frames as the menu (Assets/UI/Generated, baked by UiArtSetup), so
   the fight and the screens either side of it are plainly the same game. The layout was already
   right; what it lacked was any material. */

.hud-root {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px;
}

/* The HUD must never eat board clicks; only its own controls are interactive. */
.hud-root,
.party-column,
.card {
    /* picking-mode is set from code on the root; these keep children hit-testable */
}

/* ---------- party column ---------- */

/* No frame and no heading. The cards are the panel: a box drawn round them said only that a box
   had been drawn, and it took a column of board to say it. */
.party-column {
    /* The runes, the card, its border, and room for the scroller when the party outgrows it. */
    width: 132px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}


.portrait-list {
    max-height: 560px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
}

/* Never squeezed to fit. A flex item shrinks by default, and in a column that costs it height the
   text inside does not give back -- so a full party used to draw its names outside their cards.
 *
 * The items, which live in the content container, and NOT the scroll view's own children. A
 * ScrollView's direct children are its viewport and its scrollers: telling those not to shrink
 * pins the viewport open to the full height of everything inside it, so the content never
 * overflows, so there is nothing to scroll and no scrollbar that does anything -- and the content
 * draws straight out of the frame over whatever is under it. That one selector is why the combat
 * log did not scroll, however the wheel was read. */
.portrait-list .unity-scroll-view__content-container > *,
.card__stats > * {
    flex-shrink: 0;
}

/* A face with what it is holding down one side and what is left of it along the bottom. The
   picture is the card: a frame round a frame round a face is three borders and one fact. */
.portrait {
    width: 76px;
    height: 92px;
    justify-content: flex-end;
    overflow: hidden;
    background-color: rgb(10, 12, 16);
    -unity-background-scale-mode: scale-and-crop;

    /* The owner's colour, set from code. The whole edge, because there is no second fact
       competing for it now that a click no longer selects. */
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.portrait:hover {
    border-color: rgb(226, 191, 122);
}

/* Fallen. Still in the column, because the party is still the party; dimmed, because it is
   plainly gone. */
.portrait--fallen {
    opacity: 0.38;
}

/* On your side, but not yours to move. Greyed rather than removed or badged: the party is the
   party, and the difference is one a player should be able to see without reading anything. */
.portrait--theirs {
    -unity-background-image-tint-color: rgb(146, 149, 156);
    opacity: 0.82;
}

/* The letter shown when a creature has no face of its own. */
.portrait__initial {
    position: absolute;
    top: 22px;
    left: 0;
    right: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(120, 128, 148);
    -unity-text-align: middle-center;
}

/* One row per creature: what it is holding, then its face. */
.party-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
}

/* What it is holding, beside the card, one rune to a line and right against it. */
.portrait__elements {
    align-items: flex-end;
    margin-right: 4px;
    padding-top: 2px;
}

.portrait__element {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

/* The graveyard: what this creature has spent and not got back, oldest on the left. Public
   information, and the order is what Take a Breath returns them in. Laid across rather than
   down, because it is a queue and reads as one. */
.portrait__spent {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    opacity: 0.45;
}

.portrait__rune--spent {
    width: 8px;
    height: 8px;
    margin-left: 2px;
}

.portrait__rune {
    width: 12px;
    height: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.portrait__count {
    margin-left: 2px;
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

/* Bars sit on the picture rather than under it: the card is the size of the face. */
.portrait__bars {
    background-color: rgba(4, 5, 8, 0.55);
}

/* Stand-in when a creature has no portrait sprite: its initial on a plain tile. */
.portrait__initial {
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(120, 128, 146);
}



/* Track stays visible so a nearly-empty bar still reads as "hurt" rather than "missing". */
/* Health and armour read the same way wherever they are drawn: a dark track, a fill that is the
   fraction left, and the numbers over the top of both for the creature being looked at. */
.hp-track {
    height: 14px;
    justify-content: center;
    background-color: rgba(8, 9, 13, 0.9);
    overflow: hidden;
}

/* Red, which is what a health bar is. It spent a while green, which read as a good-news bar on a
   creature that was dying. */
.hp-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    background-color: rgb(158, 44, 44);
}

.bar-text {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(240, 236, 228);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

/* ---------- summary card ---------- */

/* Pinned to the HUD rather than sized by what is on it: top with everything else, bottom on the
   line the log and the footer sit on. What does not fit scrolls. */
.card {
    position: absolute;
    right: 16px;
    top: 16px;
    bottom: 130px;
    width: 290px;
    padding: 18px;
    background-image: url("../Art/UI/ui-panel.png");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.88);
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

/* The side, first and in that side's colour. A card is read to answer "what is that thing" and
   the first half of that answer is which team it is on. */
.card__party {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.card__head {
    flex-direction: row;
    margin-bottom: 10px;
}

/* Blocks, rather than one column of everything. The card carries five different kinds of thing and
   without a break between them they read as one list of facts. */
.card__rule {
    height: 1px;
    margin: 10px 0 10px 0;
    background-color: rgba(255, 255, 255, 0.08);
}

/* The face, cropped to a circle, the same shape the board token wears. */
.card__portrait {
    width: 56px;
    height: 56px;
    margin-right: 12px;
    flex-shrink: 0;
    border-radius: 28px;
    overflow: hidden;

    /* Ringed in the party colour, which the band above it is written in. The side is then legible
       from the shape of the card without reading a word of it. */
    border-width: 2px;
    background-color: rgb(18, 21, 28);
    background-image: url("../Art/UI/ui-well.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
}

.card__titles {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.card__name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
}

.card__subtitle {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(198, 158, 88);
    margin-top: 2px;
}

.card__controller {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(139, 147, 165);
    margin-top: 6px;
}

.card__stats {
    margin-bottom: 10px;
}

/* Minimums rather than fixed heights, on everything that holds text: a fixed height is a promise
   about font metrics the stylesheet cannot keep, and when it is wrong the text draws outside its
   own frame. */
.stat-row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding: 3px 8px;
    margin-bottom: 4px;
    background-image: url("../Art/UI/ui-card.png");
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
}

.stat-row__label {
    width: 38px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(139, 147, 165);
}

.stat-row__value {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(232, 226, 212);
}

/* Discrete pips, not a bar: players count remaining actions rather than estimating them. */
.pips {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    margin-right: 8px;
}

.pip {
    width: 7px;
    height: 12px;
    margin-right: 3px;
    background-color: rgb(38, 43, 56);
    border-width: 1px;
    border-color: rgb(20, 23, 30);
}

.pip--filled {
    background-color: rgb(226, 191, 122);
    border-color: rgb(140, 106, 52);
}

/* Every second pip closes a whole point, so a half-unit budget stays countable. */
.pip--whole {
    margin-right: 7px;
}

/* Flavour, directly under the name it flavours. It used to sit at the bottom under the skill list,
   which put the one line telling you what a creature *is* furthest from its name. */
.card__description {
    font-size: 12px;
    color: rgb(130, 138, 156);
    white-space: normal;
    margin-bottom: 12px;
    -unity-font-style: italic;
}

.is-hidden {
    display: none;
}

/* ---------- turn order bar ---------- */

/* The bar sits on a shade of fixed height rather than wearing one: the band is what stops the
   round label being drawn over a token, and it should be exactly as tall as that needs and not a
   pixel more. Everything above the board is space the player cannot use. */
.turn-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding-top: 6px;
    padding-bottom: 4px;
    align-items: center;
}

.turn-bar__order {
    flex-direction: row;
    align-items: flex-end;
}

/* Whose turn it is, under the order. The name used to float over a disc in the world, where it
   labelled a cursor rather than answering the question a player actually asks. */

/* Reserved whether or not there is a name, so portraits do not shift as turns pass. */

/* The order of play, as faces. The one acting is bigger and named; the rest are the same card
   without the numbers, because "who is next" is a question about faces and not about health. */
.turn-portrait {
    width: 52px;
    height: 64px;
    margin: 0 3px;
    justify-content: flex-end;
    background-color: rgb(10, 12, 16);
    border-width: 2px;
    border-color: rgb(52, 59, 76);
    -unity-background-scale-mode: scale-and-crop;
}

/* The active creature reads first: larger, lifted, and the only one ringed in gold. */
.turn-portrait--active {
    width: 72px;
    height: 88px;
    margin: 0 8px;
    border-color: rgb(226, 191, 122);
}

.turn-portrait--dimmed {
    opacity: 0.72;
}

/* Already had its turn this round. Further back than the ones still to come, so the bar reads left
   to right as "done, now, next" without anybody having to count. */
.turn-portrait--acted {
    opacity: 0.34;
}

.turn-portrait__initial {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(120, 128, 148);
    -unity-text-align: middle-center;
}

/* Under the card, and out of the flow: the row is a row of faces and a name must not push the
   face beside it sideways. */
.turn-portrait__name {
    position: absolute;
    top: 100%;
    left: -40px;
    right: -40px;
    margin-top: 3px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(236, 231, 219);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

/* Action points, over the portrait and above the health, and only on the creature whose turn it
   is. Everybody else is about to refill. */


/* Health sits over the portrait rather than beside it, so a row of them stays scannable. Short
   enough that the armour bar can sit above it without the pair eating the portrait. */



/* ---------- end turn ---------- */

/* Full width, along the bottom. Everything else on the HUD stops at the line it draws. */
/* Every pixel here is a row of tiles the player cannot see, so the band is as short as its
   contents: one line of what the turn is spent out of, and the bar it is spent on. */
.turn-footer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    padding: 4px 16px 4px 16px;
}

/* The shade under the bar. The gradient is drawn for the top of the screen, so the leaf that
   carries it is turned over; nothing else is. */
/* The hand, the points and the button on one line, across the whole width. */

/* The bar and the button that ends the turn, as one row. */
.action-row {
    flex-direction: row;
    align-items: center;
}

.spacer {
    flex-grow: 1;
}

.end-turn {
    height: 40px;
    margin-left: 12px;
    padding: 0 18px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(220, 224, 234);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/UI/ui-button.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

.end-turn:hover {
    background-image: url("../Art/UI/ui-button-hot.png");
    color: rgb(245, 247, 252);
}

/* Prompts, never forces: the turn still only ends on a click. Nothing left to spend puts a gold
   outline on the button and blinks it; the words stay the words. */
.end-turn--spent {
    border-color: rgba(226, 191, 122, 0.45);
    transition-property: border-color, scale;
    transition-duration: 0.5s, 0.12s;
    transition-timing-function: ease-in-out;
}

.end-turn--spent.end-turn--pulse {
    border-color: rgb(226, 191, 122);
}

/* ---------- floating notes ---------- */

.floating-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Absolute, because every one of these is placed from a world position each frame rather than
   laid out. Bold, at a size that reads over a lit board without covering the creature. */
.floating-note {
    position: absolute;
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(226, 191, 122);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.9);
    transform-origin: center;
}

/* Something taken rather than gained. The same red the health bar uses, so a number and a bar
   falling together are obviously the same event. */
.floating-note--loss {
    color: rgb(226, 108, 96);
}

/* ---------- cursor ---------- */

/* Two lines now: what the click does, and how it is likely to go. */
.cursor-action {
    white-space: normal;
    max-width: 280px;
    position: absolute;
    padding: 5px 10px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(236, 231, 219);
    background-color: rgba(5, 6, 9, 0.9);
    border-width: 1px;
    border-color: rgb(58, 66, 84);
}

/* ---------- outcome ---------- */

.outcome {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 6, 9, 0.78);
}

.outcome__title {
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: rgb(236, 231, 219);
}

.outcome__note {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(139, 147, 165);
}

/* ---------- experience ---------- */

/* The same bar the menu draws, because it answers the same question in the same shape. Only a
   character somebody brought has one: a premade does not level and has nowhere to put it. */
.xp {
    margin: 4px 0 10px 0;
}

.xp-track {
    height: 7px;
    background-color: rgb(24, 27, 35);
    border-width: 1px;
    border-color: rgb(52, 59, 76);
    overflow: hidden;
}

.xp-fill {
    height: 100%;
    background-color: rgb(120, 148, 200);
}

.xp-fill--ready {
    background-color: rgb(226, 191, 122);
}

.xp-label {
    margin-top: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(120, 128, 146);
}

.xp-label--ready {
    color: rgb(226, 191, 122);
}

/* ---------- element counters ---------- */

.card__elements-title {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(198, 158, 88);
    margin-top: 12px;
    margin-bottom: 6px;
}

.card__elements {
    flex-direction: row;
    flex-wrap: wrap;
}

/* The graveyard heading, and the note that stands in for an empty row. Both take the full width of
   the wrapping row so what follows starts on a fresh line. */
/* What a creature has been seen doing. A name and a price per row, so the list can be scanned
   for "can it reach me and can it afford it" without reading any of it properly. */
.card__skills {
    margin-top: 4px;
}

.card__skills > * {
    flex-shrink: 0;
}

/* Name and price on one line, what it does under them. Reading an enemy's card is how a player
   finds out what is about to be thrown at them. */
.card-skill {
    flex-direction: column;
    padding: 3px 0;
}

.card-skill__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.card-skill__text {
    margin-top: 1px;
    font-size: 10px;
    white-space: normal;
    color: rgb(150, 145, 134);
}

.card-skill__name {
    font-size: 13px;
    color: rgb(214, 209, 197);
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-skill__cost {
    flex-shrink: 0;
    margin-left: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(178, 184, 200);
}

.card__spent-title {
    width: 100%;
    margin-top: 8px;
    margin-bottom: 4px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(139, 147, 165);
}

.card__elements-note {
    width: 100%;
    font-size: 10px;
    -unity-font-style: italic;
    color: rgb(110, 118, 136);
}

/* Spent, not held. Dimmed, so the two rows read as different kinds of thing at a glance rather than
   only by their heading. */
.element-chip--spent {
    opacity: 0.55;
}

/* One element and how much of it is held. The rune is set inline from the icon library; the gem
   below it is what shows through when a project has no art for that element yet. */
.element-chip {
    flex-direction: row;
    align-items: center;
    margin: 0 10px 5px 0;
}

.element-chip__mark {
    width: 26px;
    height: 26px;
    background-image: url("../Art/UI/ui-gem.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* The eighth mark: what is held and not identified. A plate rather than a rune, because there is
   no rune for "something", and bright enough that it reads as a real quantity rather than as an
   element that failed to load. */
.element-chip__mark--unknown {
    background-image: url("../Art/UI/ui-gem.png");
    -unity-background-image-tint-color: rgb(96, 104, 124);
    justify-content: center;
}

.element-chip__unknown {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(236, 232, 222);
    -unity-text-align: middle-center;
}

.element-chip__count {
    margin-left: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(226, 222, 210);
}

/* Nothing held, still drawn so the row does not change width as a fight goes on. */
.element-chip--none {
    opacity: 0.22;
}

/* ---------- what a clash came to ---------- */

/* One line, centred, above the skill bar. This replaced three numbers floating off two different
   heads at the same moment, which came to "something happened and I do not know what". */
.clash-result {
    position: absolute;
    left: 50%;
    top: 16%;
    translate: -50% 0;
    align-items: center;
    padding: 10px 22px;
    background-image: url("../Art/UI/ui-panel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

.clash-result__skill {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(150, 158, 176);
}

.clash-result__exchange {
    flex-direction: row;
    align-items: center;
    margin: 6px 0 4px 0;
}

.clash-result__side {
    flex-direction: row;
    align-items: center;
}

.clash-result__mark {
    width: 30px;
    height: 30px;
    margin: 0 2px;
    background-image: url("../Art/UI/ui-gem.png");
    -unity-background-scale-mode: scale-to-fit;
}

.clash-result__versus {
    margin: 0 12px;
    font-size: 11px;
    -unity-font-style: italic;
    color: rgb(120, 128, 146);
}

.clash-result__none {
    margin: 0 4px;
    font-size: 11px;
    -unity-font-style: italic;
    color: rgb(110, 118, 136);
}

.clash-result__outcome {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

/* The colour is set from code, because it names an outcome and the outcome is oriented to whoever
   is reading it -- green for a win, gold for a tie, red for a loss. */

/* ---------- the defender's prompt ---------- */

/* Centred and large, because it appears when it is not your turn -- the one moment nothing else on
   screen is addressed to you, and the whole match is waiting on it. */
/* Along the bottom, not across the middle.
 *
 * It goes up during somebody else's turn, and where it used to sit it covered the result of the
 * attack before it -- so a defender answered without being able to read what had just happened.
 * Down here it clears the result, the banner and the log, and it is the width of what is on it. */
.clash-prompt {
    position: absolute;
    left: 50%;
    bottom: 130px;
    translate: -50% 0;

    /* Four answers to a row, two rows: eight buttons in a line was a panel wider than the board.
       The width is what four of them come to, and the buttons are what their own numbers need. */
    width: 452px;
    padding: 12px 16px 12px 16px;
    background-image: url("../Art/UI/ui-panel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

/* The offer of a swing, which is the clash panel asking the other way round. Marked in the colour
   of a thing you are being given rather than a thing being done to you. */
.clash-prompt--opportunity {
    border-left-width: 3px;
    border-left-color: rgb(198, 158, 88);
}

.clash-prompt__title {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(232, 226, 212);
}

.clash-prompt__reason {
    margin-top: 2px;
    font-size: 11px;
    white-space: normal;
    color: rgb(150, 158, 176);
    white-space: normal;
}

.clash-prompt__options {
    flex-wrap: wrap;
    justify-content: center;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}

/* One per element held, with what is left of it. The count is the defender's own business, which is
   why it can be shown at all. */
.clash-option {
    width: 105px;
    height: 122px;
    margin: 0 8px 8px 0;
    padding: 8px 0;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/UI/ui-card.png");
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

.clash-option:hover {
    -unity-background-image-tint-color: rgb(190, 200, 220);
}

.clash-option:disabled {
    opacity: 0.32;
}

/* Chosen. A gold edge and a warm fill, the same "this is the one" the rest of the game uses --
   and unmistakable, because the earlier version marked the choice with a tint alone and the
   player could not tell it from the ones they had not picked. */
.clash-option--staged {
    border-color: rgb(226, 191, 122);
    -unity-background-image-tint-color: rgb(236, 206, 150);
}

.clash-option--staged .clash-option__name {
    color: rgb(255, 244, 234);
}

.clash-option__mark {
    width: 40px;
    height: 40px;
    background-image: url("../Art/UI/ui-gem.png");
    -unity-background-scale-mode: scale-to-fit;
}

.clash-option__name {
    margin-top: 3px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(226, 222, 210);
}

.clash-option__count {
    font-size: 11px;
    color: rgb(139, 147, 165);
}

/* What this answer is worth, in the same order as the key above the row. */
.clash-option__odds {
    margin-top: 3px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(150, 176, 216);
}

.clash-prompt__key {
    white-space: normal;
    margin-top: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(110, 118, 136);
}

.clash-prompt__tally {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(139, 147, 165);
}

.clash-prompt__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

/* An attack arriving outside the defender's front. Gold, because it is a thing in the player's
   favour and everything in their favour in this game is gold. */
.is-flank {
    color: rgb(232, 197, 128);
}

/* ---------- panel buttons ---------- */

/* The arena grew two panels with buttons on them -- the defence prompt and the offer of a swing --
   and neither had a button style, because the only button the HUD used to have was End Turn. The
   same frame as that one, at the size a dialog wants. */
.button {
    height: 32px;
    padding: 0 18px;
    margin-left: 8px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(214, 218, 230);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/UI/ui-button.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

.button:hover {
    -unity-background-image-tint-color: rgb(196, 206, 228);
}

.button:disabled {
    opacity: 0.4;
}

/* The answer the panel expects: the ember frame, with light text on it, the same as the menu. */
.button--primary {
    color: rgb(255, 244, 234);
}

.button--primary:hover {
    color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgb(255, 236, 220);
}

/* An option with nothing to choose: the one attack a swing is made of. It reads like the defence
   options beside it and does not pretend to be clickable. */
.clash-option--fixed {
    flex-direction: row;
    align-items: center;
}

.clash-option--fixed:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* ---------- context menu ---------- */

/* The sheet behind the menu. Invisible, and pickable on purpose: it is what makes a click anywhere
   else close the menu instead of reaching the board through it, so there is no other dismissal
   handling anywhere. */
.context-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.context-menu {
    position: absolute;
    min-width: 190px;
    padding: 5px;
    background-image: url("../Art/UI/ui-panel.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

/* A row, not a box with a word in it. These are read down a list rather than picked out of a
   cluster, so they want to be as close together as a pointer allows. */
.context-item {
    flex-direction: row;
    align-items: center;
    height: 26px;
    margin: 0;
    padding: 0 9px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
}

.context-item:hover {
    background-color: rgba(120, 148, 200, 0.22);
}

.context-item:disabled {
    opacity: 0.42;
}

.context-item__label {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(226, 222, 210);
}

.context-item__cost {
    margin-left: 14px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(139, 147, 165);
}

.context-title {
    padding: 4px 9px 2px 9px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(198, 158, 88);
}

/* The six ways to arrive. A row rather than six menu lines, because they are one choice made six
   ways and reading them down a list would suggest six different things. */
.context-facings {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2px 7px 6px 7px;
}

.context-facing {
    width: 40px;
    height: 26px;
    margin: 2px;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(220, 224, 234);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/UI/ui-button.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

.context-facing:hover {
    background-image: url("../Art/UI/ui-button-hot.png");
}

.context-note {
    padding: 0 9px 5px 9px;
    font-size: 11px;
    color: rgb(160, 168, 186);
    white-space: normal;
}

/* What the creature you are playing is holding. On the line above the things it can be spent on,
   because those are two halves of one decision and a player should never have to look away from one
   to check the other. */


/* Hand on the left, graveyard on the right, with a gap between them so they read as two facts
   rather than one long row of runes. */


/* Spent runes are shown one by one, oldest first, rather than counted. The order is the fact:
   Take a Breath returns the leftmost. */

/* The one that comes back next, at full strength with the others behind it. */

/* ---------- the action bar ---------- */

/* A row of fixed slots: walking, eight skills, a divider, three held for items. Fixed, so a
   player learns where Strike is and presses 2 without looking. */
.action-bar {
    flex-direction: row;
    align-items: center;
}

.action-bar > * {
    flex-shrink: 0;
}

/* Smaller, and carrying only what a hand needs to find it again: the picture and the key. What it
   costs is shown against the cursor once it is armed, where the player is already looking. */
.action-slot {
    width: 42px;
    height: 42px;
    margin: 0 2px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/UI/ui-card.png");
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
}

/* Named above itself while the pointer is on it, centred on the slot by construction so nothing
   has to measure anything. Only one is ever visible, so the width is free. */
.action-slot__name {
    position: absolute;
    bottom: 100%;
    left: 50%;
    translate: -50% -8px;
    padding: 3px 9px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(236, 231, 219);
    background-color: rgba(4, 5, 8, 0.92);
    white-space: nowrap;
    display: none;
}

.action-slot--named .action-slot__name {
    display: flex;
}

.action-slot:hover {
    -unity-background-image-tint-color: rgb(196, 206, 228);
}

.action-slot:disabled {
    opacity: 1;
}

/* The picture fills the slot; the numbers sit on its corners. */
.action-slot__icon {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Which key presses it, top left, small and out of the picture's way. */
.action-slot__key {
    position: absolute;
    left: 3px;
    top: 1px;
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(168, 175, 192);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* The action points, bottom right, in the gold every price is written in. */

/* The element, bottom left, as its rune -- and a count only when it is more than one. */



/* Unusable, not hidden: the slot is where it always is, and the tooltip says why. */
.action-slot--unusable {
    opacity: 0.38;
}

/* Armed. The gold edge every "this is the one" in the game wears. */
.action-slot--selected {
    border-color: rgb(226, 191, 122);
    -unity-background-image-tint-color: rgb(236, 214, 170);
}

.action-slot--move {
    -unity-background-image-tint-color: rgb(178, 190, 214);
}

.action-slot--move.action-slot--selected {
    -unity-background-image-tint-color: rgb(226, 214, 190);
}

/* Nothing in it yet. The frame and the key, dimmed, so the bar keeps its shape. */
.action-slot--empty {
    opacity: 0.3;
}

.action-bar__divider {
    width: 2px;
    height: 40px;
    margin: 0 10px;
    background-color: rgba(198, 158, 88, 0.35);
}

/* Picking what a fist is made of. The slots become the question while it is being asked. */
.skill-choice__title {
    -unity-text-align: middle-center;
    margin-right: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(198, 158, 88);
}

.action-slot__rune-large {
    width: 30px;
    height: 30px;
    margin-bottom: 2px;
    background-image: url("../Art/UI/ui-gem.png");
    -unity-background-scale-mode: scale-to-fit;
}

.action-slot__caption {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(226, 222, 210);
}

.action-slot--cancel {
    width: 74px;
    font-size: 11px;
    color: rgb(139, 147, 165);
}


/* ---------- combat log ---------- */

/* Bottom left, under the party column and clear of the centred footer. A log belongs beside the
   people it is about, and the left column is already where a player looks to find out who is in
   the fight. */
/* Ghosted, because it sits over the board. A log is something you consult rather than something
   you watch, so at rest it gives the tiles underneath back and firms up when you go to read it. */
/* Two sizes. Shut, it is the last thing that happened and nothing else; open, it is the record.
   Neither has a frame worth the name -- the lines carry their own shadow. */
.combat-log {
    position: absolute;
    left: 16px;
    bottom: 104px;
    width: 420px;
}

.combat-log__frame {
    height: 176px;
    padding: 6px 10px 6px 10px;
    background-color: rgba(4, 5, 8, 0.62);

    /* Clipped at the frame, whatever the list inside it thinks its height is. The log sits above
       the action bar and must stay there: lines spilling out of the bottom of this box land on
       the slots, and a bar you cannot read is worse than a log you cannot see. */
    overflow: hidden;
}

.combat-log__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3px;
}

/* The divider between what a creature can do and what it is carrying. */
.action-bar__divider {
    width: 2px;
    height: 34px;
    margin: 0 8px;
    background-color: rgba(198, 158, 88, 0.35);
}

.combat-log__title {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(139, 147, 165);
}

/* Shut: one line, floated left, no box at all. */
.combat-log__sliver {
    display: none;
    max-width: 420px;
    height: auto;
    padding: 3px 8px;
    font-size: 12px;
    color: rgb(186, 192, 206);
    background-color: rgba(4, 5, 8, 0.5);
    border-width: 0;
    -unity-text-align: middle-left;
    white-space: normal;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.combat-log__sliver:hover {
    color: rgb(236, 231, 219);
    background-color: rgba(4, 5, 8, 0.72);
}

.combat-log--small .combat-log__frame {
    display: none;
}

/* Shown from code: it is hidden while the record is open and hidden before anything has
   happened, and one rule cannot answer to both. */



/* Fills the frame and scrolls inside it.
 *
 * The min-height is the whole fix and it is not optional: a flex item defaults to a minimum size of
 * its own content, so a scroller told to grow inside a fixed frame grows straight past it and takes
 * the lines with it. That is why this looked like it was ignoring its height -- it was. */
.combat-log-list {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
}

.combat-log-list .unity-scroll-view__content-viewport {
    overflow: hidden;
}

/* A line you are in gets a rail rather than just brighter text: colour alone is doing enough work
   in here already, naming two creatures and an outcome. */
.combat-log__line--mine {
    padding-left: 6px;
    border-left-width: 2px;
    border-left-color: rgb(198, 158, 88);
}

/* Lines wrap rather than being cut off: half a sentence about an element nobody can read is worse
   than no line at all. And they never shrink, for the same reason the party column does not -- the
   items, in the content container, never the scroll view's own children. */
.combat-log-list .unity-scroll-view__content-container > * {
    flex-shrink: 0;
}

.combat-log__line {
    white-space: normal;
    font-size: 12px;
    color: rgb(168, 175, 192);
    margin-bottom: 1px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* A line the reader is part of, brighter than the traffic around it. */
.combat-log__line--mine {
    color: rgb(226, 222, 212);
}


/* ---------- motion ---------- */

.button,
.action-slot,
.end-turn,
.clash-option,
.context-item,
.portrait,

.button:active,
.action-slot:active,
.end-turn:active,
.clash-option:active,
.context-item:active {
    scale: 0.97;
}

/* Portraits ease when one is resized or dimmed in place. The bar is rebuilt on most changes, so
   this mostly covers hover and the acted-dimming; it is here so a future bar that keeps its
   elements gets the growth for free. */
.turn-portrait {
    transition-property: width, height, opacity, border-color, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
}

/* Prompts and the exchange strip open like something being put in front of you: a touch small
   and a touch faint for a sixth of a second, then there. Scale rather than a rise, because these
   are centred with a translate of their own and a second one would fight it. */
.clash-prompt,
.clash-result {
    opacity: 0;
    scale: 0.96;
    transition-property: opacity, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.clash-prompt--in,
.clash-result--in {
    opacity: 1;
    scale: 1;
}

.context-menu {
    opacity: 0;
    scale: 0.94;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.context-menu--in {
    opacity: 1;
    scale: 1;
}

/* The hover marker on the board is a prefab; the card and the log are what change on screen when
   somebody is inspected, and the card in particular used to blink into place. */
.card {
    transition-property: opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.card.is-hidden {
    display: flex;
    opacity: 0;
    translate: 0 -6px;
}

/* ---------- turn banner ---------- */

/* Two words across the middle when the turn changes hands, and gone. It drops in from slightly
   above and leaves slightly below, so it reads as passing through rather than switching on. */
.turn-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 24%;
    align-items: center;
    opacity: 0;
    translate: 0 -14px;
    transition-property: opacity, translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.turn-banner--in {
    opacity: 1;
    translate: 0 0;
}

.turn-banner--out {
    opacity: 0;
    translate: 0 12px;
    transition-duration: 0.35s;
    transition-timing-function: ease-in;
}

.turn-banner__title {
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 10px;
    color: rgb(236, 231, 219);
    text-shadow: 0 3px 8px rgba(0, 0, 0, 0.95);
}

/* Yours is gold, because everything that is yours to do in this game is gold. */
.turn-banner--mine .turn-banner__title {
    color: rgb(226, 191, 122);
}

.turn-banner__round {
    margin-top: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: rgb(139, 147, 165);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
}

/* ---------- action points in the footer ---------- */

.ap-row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
}

.ap-row__text {
    margin-left: 12px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(226, 191, 122);
}

/* Larger than the card's: these are the ones a player counts every turn. */
.pips--footer {
    flex-grow: 0;
    margin-right: 0;
}

.pips--footer .pip {
    width: 10px;
    height: 14px;
    margin-right: 3px;
}

.pips--footer .pip--whole {
    margin-right: 9px;
}

/* ---------- the eighth answer ---------- */

/* Held nothing of: dim, and dead. Still drawn, because the seven are a set. */
.clash-option--empty {
    opacity: 0.3;
}

/* Nothing: a circle with a bar through it, drawn rather than pictured, in the colour of a loss. */
/* The same size as the gems beside it. It was drawn at its own size and stood half again as
   tall as every other answer on the row. */
.clash-option__mark--none {
    width: 26px;
    height: 26px;
    min-width: 26px;
    max-width: 26px;
    flex-shrink: 0;
    align-self: center;
    background-image: none;
    border-width: 2px;
    border-color: rgb(217, 112, 94);
    border-radius: 13px;
    align-items: center;
    justify-content: center;
}

.clash-option__mark-bar {
    width: 18px;
    height: 2px;
    background-color: rgb(217, 112, 94);
    rotate: -45deg;
}

/* What is known about the attack, between the stakes and the row. */
.clash-prompt__intel {
    margin-top: 8px;
    font-size: 12px;
    color: rgb(168, 175, 192);
    white-space: normal;
}

.clash-prompt__intel--known {
    color: rgb(226, 191, 122);
}

/* ---------- armour ---------- */

/* Silver, above the green. A pool that never comes back, drawn as a thin bar so it reads as
   something worn over the health rather than as a second health. */
.armour-track {
    height: 12px;
    justify-content: center;
    background-color: rgba(8, 9, 13, 0.9);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.5);
    overflow: hidden;
}

.armour-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    background-color: rgb(58, 132, 154);
}

/* The turn bar's copy is numbered like the health under it, so it is the same height as a line
   of that text and the pair reads as one two-row gauge. */



.stat-row__value--armour {
    color: rgb(198, 204, 216);
}

/* ---------- scenario report ---------- */

/* The left column, above the log.
 *
 * Everything else on this HUD announces itself across the middle -- the turn banner, the result of
 * a clash, the defender's prompt -- and a report that has to be read cannot live where those pass
 * through. The right is the card's and the bottom is the log's, so it takes the space between the
 * two, and the party column stands aside while a scenario runs. */
.scenario-report {
    position: absolute;
    left: 16px;
    top: 84px;
    bottom: 276px;
    width: 400px;
    padding: 12px 16px;
    background-image: url("../Art/UI/ui-panel.png");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.92);
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

.scenario-report__title {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;

    /* Said here rather than inherited. It was reading grey on the panel's dark brown, which is
       the one line on the report that has to be legible from across the room. */
    color: rgb(240, 236, 228);
}

.scenario-report__status {
    margin-top: 2px;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(139, 147, 165);
}

.scenario-report__status--pass {
    color: rgb(126, 196, 138);
}

.scenario-report__status--fail {
    color: rgb(214, 96, 84);
}

.scenario-report__checks {
    flex-shrink: 1;
    min-height: 0;
    margin-top: 8px;
    max-height: 340px;
}

.scenario-report__check {
    font-size: 12px;
    white-space: normal;
    margin-bottom: 3px;
}

.scenario-report__check--pass {
    color: rgb(126, 196, 138);
}

.scenario-report__check--fail {
    color: rgb(214, 96, 84);
}

.scenario-report__buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

/* ---------- what the armed or hovered skill does ---------- */

/* Above the bar and centred on it, so it reads as belonging to the row under it rather than as
   another panel. Never wider than the bar it explains. */



/* ---------- what a note means, beside the number ---------- */

/* Hung outside the label's left edge, so the number stays centred on the creature it is about. */
.floating-note__mark {
    position: absolute;
    right: 100%;
    top: 4px;
    margin-right: 5px;
}

/* A blade: a bar stood on its point. It got through. */
.floating-note__mark--hit {
    width: 3px;
    height: 15px;
    rotate: 45deg;
    background-color: rgb(236, 214, 178);
}

/* On its own it is the whole note, so it lays out in flow and the label is its size. */
.floating-note__mark--alone {
    position: relative;
    right: auto;
    top: auto;
    margin-right: 0;
}

/* A guard: a plate that narrows to a point. It did not. */
.floating-note__mark--guard {
    width: 13px;
    height: 14px;
    border-width: 2px;
    border-color: rgb(150, 186, 226);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

/* The card's body. The party line stays put at the top; everything under it scrolls. */
.card__scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.card__scroll .unity-scroll-view__content-container > * {
    flex-shrink: 0;
}

/* Never wider than the card. A line that will not wrap is clipped, not scrolled sideways. */
.card__scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.card__scroll .unity-scroll-view__content-container {
    width: 100%;
}

/* ---------- the log's own way back through itself ---------- */





/* ==================================================================== the vitals cluster
 *
 * Points over health, and the button that ends the turn beside it. The gutter on the left is the
 * width of that button, which is what keeps the bar itself centred on the screen rather than
 * centred on what is left of the screen.
 */
.vitals {
    align-items: center;
    margin-bottom: 4px;
}

.vitals__row {
    flex-direction: row;
    align-items: center;
}

/* The width of the button on the other side, its margin included. The bar between them is only
   centred on the screen if the space either side of it is equal, and End Turn carries a margin
   that the gutter has to match or the bar sits half of it to the left. */
.vitals__gutter {
    width: 144px;
}

.own-vitals {
    width: 420px;
}

/* Fixed to its parent rather than sized by what is in it. The bar holds a label whose text goes
   from "24 / 24" to "8 / 24" as the fight goes on, and a bar that takes its width from its own
   contents shrinks and re-centres every time somebody is hit -- which reads as the bar sliding
   sideways when you take damage. Nothing inside it is allowed to decide how wide it is. */
.own-health {
    width: 100%;
    height: 20px;
    justify-content: center;
    overflow: hidden;
    background-color: rgba(8, 9, 13, 0.92);
    border-width: 1px;
    border-color: rgb(36, 42, 54);
}

.own-health__fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    background-color: rgb(158, 44, 44);
}

.own-health__text {
    position: absolute;
    left: 0;
    right: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(244, 238, 230);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

.ap-row {
    width: 420px;
    justify-content: center;
    margin-bottom: 2px;
}

.end-turn {
    width: 132px;
}

/* Whose turn it is, over the bar, small and permanent. */
.turn-announce {
    margin-bottom: 3px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(226, 191, 122);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

/* Where the round ends: everything past it goes again next round. */
.turn-break {
    width: 2px;
    height: 44px;
    margin: 0 10px;
    background-color: rgba(226, 191, 122, 0.55);
}

/* Arriving at the back of the queue. The card is built here and released a frame later, so the
   transition below carries it the rest of the way. */
.turn-portrait--arriving {
    translate: 70px 0;
    opacity: 0;
}

/* ==================================================================== the menu buttons
 *
 * Three, on the left of the bar, in the order a character is put together: what it wears, what it
 * knows, what it carries.
 */
.action-menu {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.action-menu__button {
    width: 36px;
    height: 36px;
    margin: 0 2px;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(198, 158, 88);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/UI/ui-button.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

.action-menu__button:hover {
    background-image: url("../Art/UI/ui-button-hot.png");
    color: rgb(244, 226, 190);
}

.action-menu__button:disabled {
    opacity: 0.45;
}

/* ==================================================================== icon buttons
 *
 * A close, a minimise and a pin, drawn out of their own boxes rather than set in a typeface. The
 * pieces are plain elements: a cross is two bars crossed, a pin is a head on a stem.
 */
.icon-button {
    width: 20px;
    height: 20px;
    margin: 0 0 0 4px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(120, 130, 150, 0.35);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.icon-button:hover {
    background-color: rgba(226, 191, 122, 0.22);
    border-color: rgb(226, 191, 122);
}

.icon-bar {
    position: absolute;
    background-color: rgb(198, 204, 216);
}

.icon-button:hover .icon-bar {
    background-color: rgb(244, 226, 190);
}

/* A cross: two bars through the middle, turned against each other. */
.icon-bar--slash {
    width: 12px;
    height: 2px;
    rotate: 45deg;
}

.icon-bar--backslash {
    width: 12px;
    height: 2px;
    rotate: -45deg;
}

/* A minimise: one bar along the bottom. */
.icon-bar--floor {
    width: 12px;
    height: 2px;
    bottom: 4px;
}

/* A pin: a round head over a stem, leaning until it is pushed in. */
.icon-pin {
    width: 14px;
    height: 14px;
    align-items: center;
    rotate: -35deg;
}

.icon-pin__head {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(198, 204, 216);
}

.icon-pin__stem {
    width: 2px;
    height: 6px;
    background-color: rgb(198, 204, 216);
}

.icon-button--pinned .icon-pin {
    rotate: 0deg;
}

.icon-button--pinned {
    background-color: rgba(226, 191, 122, 0.3);
    border-color: rgb(226, 191, 122);
}

.icon-button--pinned .icon-pin__head,
.icon-button--pinned .icon-pin__stem {
    background-color: rgb(244, 226, 190);
}

/* ==================================================================== the card corner
 *
 * Pin and close, in that order, over the top right of the inspector.
 */
.card__corner {
    position: absolute;
    top: 8px;
    right: 8px;
    flex-direction: row;
}

/* ==================================================================== one skill, in full
 */
.skill-window {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: 150px;
    width: 320px;
    padding: 14px 16px 16px 16px;
    background-image: url("../Art/UI/ui-panel.png");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.94);
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5;
}

.skill-window__head {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.skill-window__name {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(236, 231, 219);
}

.skill-window__cost {
    margin-top: 2px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(226, 191, 122);
}

.skill-window__text {
    margin-top: 8px;
    font-size: 12px;
    white-space: normal;
    color: rgb(186, 192, 206);
}

.skill-window__stats {
    margin-top: 10px;
}

.skill-window__row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.skill-window__label {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(139, 147, 165);
}

.skill-window__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(232, 226, 212);
}
