/* Arena HUD. Party column upper-left, summary card upper-right -- the Baldur's Gate / Pillars
   layout, where the portrait column and its health readout live together on the left.

   Dressed in the same generated frames as the menu (Assets/UI/Generated, baked by UiArtSetup), so
   the fight and the screens either side of it are plainly the same game. The layout was already
   right; what it lacked was any material. */

.hud-root {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px;
}

/* The HUD must never eat board clicks; only its own controls are interactive. */
.hud-root,
.party-column,
.card {
    /* picking-mode is set from code on the root; these keep children hit-testable */
}

/* ---------- party column ---------- */

.party-column {
    width: 250px;
    padding: 12px 12px 8px 12px;
    background-image: url("Generated/ui-panel.png");
    -unity-slice-left: 16;
    -unity-slice-right: 16;
    -unity-slice-top: 16;
    -unity-slice-bottom: 16;
}

.party-title {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(198, 158, 88);
    margin-bottom: 8px;
}

.portrait-list {
    max-height: 420px;
    overflow: hidden;
}

/* Never squeezed to fit. A flex item shrinks by default, and in a column that costs it height the
   text inside does not give back -- so a full party used to draw its names outside their cards. */
.portrait-list > *,
.card__stats > *,
.skill-bar > * {
    flex-shrink: 0;
}

.portrait {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    margin-bottom: 5px;
    background-image: url("Generated/ui-card.png");
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;

    /* The border is the ownership channel: it takes the controlling player's colour. */
    border-width: 2px;
    border-color: rgb(90, 96, 112);
}

.portrait:hover {
    -unity-background-image-tint-color: rgb(160, 170, 195);
}

.portrait--selected {
    -unity-background-image-tint-color: rgb(200, 210, 235);
}

.portrait__image {
    width: 42px;
    height: 42px;
    background-image: url("Generated/ui-well.png");
    -unity-slice-left: 11;
    -unity-slice-right: 11;
    -unity-slice-top: 11;
    -unity-slice-bottom: 11;
    -unity-background-scale-mode: scale-and-crop;
}

/* Stand-in when a creature has no portrait sprite: its initial on a plain tile. */
.portrait__initial {
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(120, 128, 146);
}

.portrait__body {
    flex-grow: 1;
    margin-left: 8px;
}

.portrait__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(232, 226, 212);
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Track stays visible so a nearly-empty bar still reads as "hurt" rather than "missing". */
.hp-track {
    height: 6px;
    margin-top: 5px;
    background-color: rgb(30, 14, 18);
    border-width: 1px;
    border-color: rgb(58, 30, 34);
    overflow: hidden;
}

.hp-fill {
    height: 100%;
    background-color: rgb(196, 62, 58);
}

/* ---------- summary card ---------- */

.card {
    width: 290px;
    padding: 18px;
    background-image: url("Generated/ui-panel.png");
    -unity-slice-left: 16;
    -unity-slice-right: 16;
    -unity-slice-top: 16;
    -unity-slice-bottom: 16;
}

.card__head {
    flex-direction: row;
    margin-bottom: 12px;
}

/* The face, cropped to a circle, the same shape the board token wears. */
.card__portrait {
    width: 56px;
    height: 56px;
    margin-right: 12px;
    flex-shrink: 0;
    border-radius: 28px;
    overflow: hidden;
    background-color: rgb(18, 21, 28);
    background-image: url("Generated/ui-well.png");
    -unity-slice-left: 11;
    -unity-slice-right: 11;
    -unity-slice-top: 11;
    -unity-slice-bottom: 11;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
}

.card__titles {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.card__name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
}

.card__subtitle {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(198, 158, 88);
    margin-top: 2px;
}

.card__controller {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(139, 147, 165);
    margin-top: 6px;
}

.card__stats {
    margin-bottom: 10px;
}

/* Minimums rather than fixed heights, on everything that holds text: a fixed height is a promise
   about font metrics the stylesheet cannot keep, and when it is wrong the text draws outside its
   own frame. */
.stat-row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding: 3px 8px;
    margin-bottom: 4px;
    background-image: url("Generated/ui-card.png");
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
}

.stat-row__label {
    width: 38px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(139, 147, 165);
}

.stat-row__value {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(232, 226, 212);
}

/* Discrete pips, not a bar: players count remaining actions rather than estimating them. */
.pips {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    margin-right: 8px;
}

.pip {
    width: 7px;
    height: 12px;
    margin-right: 3px;
    background-color: rgb(38, 43, 56);
    border-width: 1px;
    border-color: rgb(20, 23, 30);
}

.pip--filled {
    background-color: rgb(226, 191, 122);
    border-color: rgb(140, 106, 52);
}

/* Every second pip closes a whole point, so a half-unit budget stays countable. */
.pip--whole {
    margin-right: 7px;
}

.card__description {
    font-size: 11px;
    color: rgb(130, 138, 156);
    white-space: normal;
}

.is-hidden {
    display: none;
}

/* ---------- turn order bar ---------- */

.turn-bar {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    align-items: center;
}

.turn-bar__round {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(198, 158, 88);
    margin-bottom: 8px;
}

.turn-bar__order {
    flex-direction: row;
    align-items: flex-end;
}

/* Whose turn it is, under the order. The name used to float over a disc in the world, where it
   labelled a cursor rather than answering the question a player actually asks. */
.turn-bar__active-owner {
    min-height: 14px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(198, 158, 88);
}

/* Reserved whether or not there is a name, so portraits do not shift as turns pass. */
.turn-bar__active-name {
    min-height: 20px;
    margin-top: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(236, 231, 219);
}

.turn-portrait {
    width: 52px;
    height: 52px;
    margin: 0 3px;
    overflow: hidden;
    justify-content: flex-end;
    background-color: rgb(18, 21, 28);
    border-width: 2px;
    border-color: rgb(52, 59, 76);
    -unity-background-scale-mode: scale-and-crop;
}

/* The active creature reads first: larger, lifted, and the only one ringed in gold. */
.turn-portrait--active {
    width: 68px;
    height: 68px;
    margin-bottom: 0;
    border-color: rgb(226, 191, 122);
}

.turn-portrait--dimmed {
    opacity: 0.4;
}

.turn-portrait__initial {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 14px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(150, 158, 178);
    -unity-text-align: middle-center;
}

/* Health sits over the portrait rather than beside it, so a row of them stays scannable. */
.turn-portrait__hp {
    min-height: 15px;
    background-color: rgba(5, 6, 9, 0.88);
    justify-content: center;
}

.turn-portrait__hp-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    background-color: rgba(112, 200, 140, 0.42);
}

.turn-portrait__hp-text {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
    -unity-text-align: middle-center;
}

/* ---------- end turn ---------- */

.turn-footer {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    align-items: center;
}

.turn-footer__ap {
    min-height: 16px;
    margin-bottom: 8px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(139, 147, 165);
}

.end-turn {
    height: 42px;
    padding: 0 34px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(220, 224, 234);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Generated/ui-button.png");
    -unity-slice-left: 11;
    -unity-slice-right: 11;
    -unity-slice-top: 11;
    -unity-slice-bottom: 11;
    border-width: 0;
}

.end-turn:hover {
    background-image: url("Generated/ui-button-hot.png");
    color: rgb(245, 247, 252);
}

/* Prompts, never forces: the turn still only ends on a click. */
.end-turn--spent {
    background-image: url("Generated/ui-button-primary.png");
    color: rgb(255, 244, 234);
}

/* ---------- cursor ---------- */

.cursor-action {
    position: absolute;
    padding: 5px 10px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(236, 231, 219);
    background-color: rgba(5, 6, 9, 0.9);
    border-width: 1px;
    border-color: rgb(58, 66, 84);
}

/* ---------- outcome ---------- */

.outcome {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 6, 9, 0.78);
}

.outcome__title {
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: rgb(236, 231, 219);
}

.outcome__note {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(139, 147, 165);
}

/* ---------- element counters ---------- */

.card__elements-title {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(198, 158, 88);
    margin-top: 12px;
    margin-bottom: 6px;
}

.card__elements {
    flex-direction: row;
    flex-wrap: wrap;
}

/* A lit gem carrying its count, the same shape the creator and the roster draw a pool with. Seven
   coloured words in a row is a legend; seven gems is a hand. */
.element-count {
    width: 28px;
    height: 28px;
    margin: 0 5px 5px 0;
    justify-content: center;
    background-image: url("Generated/ui-gem.png");
}

.element-count__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(14, 16, 22);
    -unity-text-align: middle-center;
}

/* Nothing held or nothing spent, still drawn so the row does not change width as a fight goes on. */
.element-count--none {
    opacity: 0.2;
}

/* ---------- skill bar ---------- */

.skill-bar {
    flex-direction: row;
    margin-bottom: 8px;
}

/* Wide enough for "1 AP  1 ARC" on one line and tall enough for two lines of text, because both
   were previously drawn outside a box sized for neither. */
.skill-button {
    width: 108px;
    min-height: 56px;
    margin: 0 4px;
    padding: 7px 9px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Generated/ui-button.png");
    -unity-slice-left: 11;
    -unity-slice-right: 11;
    -unity-slice-top: 11;
    -unity-slice-bottom: 11;
    border-width: 0;
    justify-content: space-between;
}

.skill-button:hover {
    background-image: url("Generated/ui-button-hot.png");
}

/* Unusable, not hidden. The reason line says why, which a missing button could not. */
.skill-button--unusable {
    opacity: 0.35;
}

.skill-button--selected {
    background-image: url("Generated/ui-button-primary.png");
}

.skill-button__name {
    flex-grow: 1;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(236, 231, 219);
    white-space: normal;
    overflow: hidden;
}

.skill-button__cost {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: space-between;
    margin-top: 4px;
}

.skill-button__ap {
    flex-shrink: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(198, 158, 88);
}

.skill-button__element {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 10px;
    -unity-font-style: bold;
}

.skill-reason {
    min-height: 16px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(226, 122, 63);
}
