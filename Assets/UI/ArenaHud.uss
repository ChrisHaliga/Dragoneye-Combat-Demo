/* Arena HUD. Party column upper-left, summary card upper-right -- the Baldur's Gate / Pillars
   layout, where the portrait column and its health readout live together on the left. */

.hud-root {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px;
}

/* The HUD must never eat board clicks; only its own controls are interactive. */
.hud-root,
.party-column,
.card {
    /* picking-mode is set from code on the root; these keep children hit-testable */
}

/* ---------- party column ---------- */

.party-column {
    width: 250px;
}

.party-title {
    font-size: 12px;
    color: rgb(190, 198, 214);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.portrait-list {
    max-height: 420px;
}

.portrait {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: rgba(18, 20, 27, 0.85);

    /* The border is the ownership channel: it takes the controlling player's colour. */
    border-width: 2px;
    border-color: rgb(90, 96, 112);
}

.portrait:hover {
    background-color: rgba(32, 36, 48, 0.95);
}

.portrait--selected {
    background-color: rgba(46, 52, 68, 0.95);
}

.portrait__image {
    width: 42px;
    height: 42px;
    border-radius: 6px;
    background-color: rgb(38, 42, 55);
    -unity-background-scale-mode: scale-and-crop;
}

/* Stand-in when a creature has no portrait sprite: its initial on a plain tile. */
.portrait__initial {
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(226, 232, 245);
}

.portrait__body {
    flex-grow: 1;
    margin-left: 8px;
}

.portrait__name {
    font-size: 13px;
    color: rgb(226, 232, 245);
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Track stays visible so a nearly-empty bar still reads as "hurt" rather than "missing". */
.hp-track {
    height: 7px;
    margin-top: 5px;
    border-radius: 4px;
    background-color: rgb(38, 20, 24);
    overflow: hidden;
}

.hp-fill {
    height: 100%;
    border-radius: 4px;
    background-color: rgb(196, 62, 58);
}

/* ---------- summary card ---------- */

.card {
    width: 290px;
    padding: 16px;
    border-radius: 12px;
    background-color: rgba(20, 22, 30, 0.94);
    border-width: 1px;
    border-color: rgb(52, 58, 74);
}

.card__name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
}

.card__subtitle {
    font-size: 12px;
    color: rgb(150, 160, 182);
    margin-top: 2px;
}

.card__controller {
    font-size: 12px;
    color: rgb(190, 198, 214);
    margin-top: 6px;
    margin-bottom: 12px;
}

.card__stats {
    margin-bottom: 10px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.stat-row__label {
    width: 42px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(130, 140, 162);
}

.stat-row__value {
    font-size: 13px;
    color: rgb(226, 232, 245);
}

/* Discrete pips, not a bar: players count remaining actions rather than estimating them. */
.pips {
    flex-direction: row;
    margin-right: 10px;
}

.pip {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    margin-right: 4px;
    background-color: rgb(58, 64, 80);
}

.pip--filled {
    background-color: rgb(232, 196, 96);
}

.card__description {
    font-size: 12px;
    color: rgb(150, 160, 182);
    white-space: normal;
}

.is-hidden {
    display: none;
}

/* ---------- turn order bar ---------- */

.turn-bar {
    position: absolute;
    top: 16px;
    left: 0;
    right: 0;
    align-items: center;
}

.turn-bar__round {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(148, 158, 180);
    margin-bottom: 6px;
}

.turn-bar__order {
    flex-direction: row;
    align-items: flex-end;
}

/* Reserved whether or not there is a name, so portraits do not shift as turns pass. */
.turn-bar__active-name {
    height: 18px;
    margin-top: 6px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
}

.turn-portrait {
    width: 52px;
    height: 52px;
    margin: 0 3px;
    border-radius: 6px;
    overflow: hidden;
    justify-content: flex-end;
    background-color: rgb(24, 27, 36);
    border-width: 2px;
    border-color: rgb(48, 53, 68);
    -unity-background-scale-mode: scale-and-crop;
}

/* The active creature reads first: larger, lifted, and the only one with a light border. */
.turn-portrait--active {
    width: 68px;
    height: 68px;
    margin-bottom: 0;
    border-color: rgb(240, 243, 250);
}

.turn-portrait--dimmed {
    opacity: 0.45;
}

.turn-portrait__initial {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 14px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(226, 232, 245);
    -unity-text-align: middle-center;
}

/* Health sits over the portrait rather than beside it, so a row of them stays scannable. */
.turn-portrait__hp {
    height: 14px;
    background-color: rgba(8, 10, 14, 0.82);
    justify-content: center;
}

.turn-portrait__hp-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    background-color: rgba(112, 200, 140, 0.45);
}

.turn-portrait__hp-text {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
    -unity-text-align: middle-center;
}

/* ---------- end turn ---------- */

.turn-footer {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    align-items: center;
}

.turn-footer__ap {
    height: 16px;
    margin-bottom: 6px;
    font-size: 12px;
    color: rgb(148, 158, 180);
}

.end-turn {
    height: 40px;
    padding: 0 26px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(226, 232, 245);
    background-color: rgb(43, 49, 65);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(56, 62, 80);
}

.end-turn:hover {
    background-color: rgb(56, 63, 82);
}

/* Prompts, never forces: the turn still only ends on a click. */
.end-turn--spent {
    background-color: rgb(198, 88, 38);
    border-color: rgb(240, 195, 120);
    color: rgb(255, 246, 240);
}

/* ---------- cursor ---------- */

.cursor-action {
    position: absolute;
    padding: 4px 8px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
    background-color: rgba(8, 10, 14, 0.85);
    border-radius: 4px;
}

/* ---------- outcome ---------- */

.outcome {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 10, 14, 0.72);
}

.outcome__title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
}

.outcome__note {
    margin-top: 8px;
    font-size: 14px;
    color: rgb(148, 158, 180);
}

/* Every second pip closes a whole point, so a half-unit budget stays countable. */
.pip--whole {
    margin-right: 6px;
}

/* ---------- element counters ---------- */

.card__elements-title {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(110, 120, 142);
    margin-top: 10px;
    margin-bottom: 4px;
}

.card__elements {
    flex-direction: row;
    flex-wrap: wrap;
}

.element-count {
    flex-direction: row;
    align-items: center;
    padding: 2px 7px;
    margin: 0 4px 4px 0;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
}

.element-count__name {
    font-size: 10px;
    -unity-font-style: bold;
    margin-right: 5px;
}

.element-count__value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(240, 243, 250);
}

/* Nothing held or nothing spent, still drawn so the row does not change width as a fight goes on. */
.element-count--none {
    opacity: 0.35;
}
